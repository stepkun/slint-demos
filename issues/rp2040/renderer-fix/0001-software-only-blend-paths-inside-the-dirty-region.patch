diff --git a/tests/screenshots/software.rs b/tests/screenshots/software.rs
index 0952027d45..1e46427acc 100644
--- a/tests/screenshots/software.rs
+++ b/tests/screenshots/software.rs
@@ -115,6 +115,47 @@ pub fn assert_with_render(
             panic!("Image comparison failure for {path} ({rotation:?}): {reason}");
         }
     }
+
+    // Render only a part of the frame again (as with RepaintBufferType::ReusedBuffer),
+    // the result must be exactly the same, also outside of the redrawn part
+    if !options.skip_clipping {
+        let rendering = screenshot_partial(window);
+        let argb8 = i_slint_core::graphics::Image::from_rgb8(rendering).to_rgba8().unwrap();
+        if let Err(reason) = compare_images(path, &argb8, RenderingRotation::NoRotation, options) {
+            panic!("Partial rendering image comparison failure for {path}: {reason}");
+        }
+    }
+}
+
+/// Renders the whole window, then fills the center with garbage and renders only the center again
+fn screenshot_partial(window: Rc<MinimalSoftwareWindow>) -> SharedPixelBuffer<Rgb8Pixel> {
+    let mut rendering = screenshot(window.clone(), RenderingRotation::NoRotation);
+    let s = window.size();
+    let sf = window.scale_factor();
+    let region: euclid::Rect<usize, euclid::UnknownUnit> =
+        euclid::rect(s.width / 4, s.height / 4, s.width / 2, s.height / 2).cast();
+    let stride = rendering.width() as usize;
+    for y in region.y_range() {
+        rendering.make_mut_slice()[y * stride..][region.x_range()].fill(Rgb8Pixel::new(
+            ((y << 3) & 0xff) as u8,
+            0,
+            255,
+        ));
+    }
+
+    window.request_redraw();
+    window.draw_if_needed(|renderer| {
+        renderer.mark_dirty_region(
+            LogicalRect::new(
+                euclid::point2(region.origin.x as f32 / sf, region.origin.y as f32 / sf),
+                euclid::size2(region.size.width as f32 / sf, region.size.height as f32 / sf),
+            )
+            .into(),
+        );
+        renderer.render(rendering.make_mut_slice(), stride);
+    });
+
+    rendering
 }
 
