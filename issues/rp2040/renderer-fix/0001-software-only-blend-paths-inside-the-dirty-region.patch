+    /// The parts of the dirty region inside `clip`, as non-overlapping rectangles.
+    /// Paths are blended with their coverage mask, so they must not be drawn outside of the
+    /// dirty region, where the buffer is not cleared, nor twice on overlapping rectangles.
+    #[cfg(feature = "path")]
+    fn path_clip_rects(&self, clip: &PhysicalRect) -> alloc::vec::Vec<PhysicalRect> {
+        self.dirty_region
+            .intersection(clip)
+            .iter()
+            .map(|(origin, size)| {
+                PhysicalRect::new(
+                    PhysicalPoint::new(origin.x as i16, origin.y as i16),
+                    PhysicalSize::new(size.width as i16, size.height as i16),
+                )
+            })
+            .collect()
+    }
