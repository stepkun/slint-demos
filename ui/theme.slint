// Shared constants for all instruments

export global Theme {
    // colors
    out property <color> background: #000000; // a full black
    out property <color> menu: #111111;       // less than black
    out property <color> sky: #1e64c8;        // medium blue
    out property <color> ground: #8b5a2b;     // earth brown
    out property <color> marking: #dddddd;    // a dimmed white
    out property <color> vehicle: #e02020;    // red vehicle symbol
    out property <color> bezel: #2a2a2a;      // dark grey ring of the round instruments
    out property <color> selected: #1e64c8;   // background of the selected button
    out property <color> normal: #20a040;     // green arc, normal operating range
    out property <color> caution: #e0c020;    // yellow arc, caution range
    out property <color> limit: #e02020;      // red line, never exceed
    out property <color> cardinal: #f08020;   // orange ticks of N, E, S and W on the heading card

    // dimensions
    out property <float> ring_ratio: 10%;       // ring thickness relative to instrument size
    // The widths and font sizes below are those of an instrument of `reference_size`, the size
    // on the display of the device. The instruments scale them with their size, so they keep
    // their proportions on the desktop, and are exactly these values on the device.
    out property <length> reference_size: 240px;
    out property <length> marking_width: 3px;
    out property <length> vehicle_width: 3px;   // line width of the vehicle symbol
    // Only these font sizes are embedded for the device (SLINT_FONT_SIZES in the build.rs of
    // both firmwares and of tools/host-check), keep them in sync.
    out property <length> menu_font_size: 12px;  // menu and status line
    out property <length> font_size: 14px;       // labels of the instruments
    out property <length> large_font_size: 20px; // numbers on the dials, heading card
}
