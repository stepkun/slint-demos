    // digits in hundreds of feet, in the ring outside the reach of the hands
    // (written out, `for` would create a component instance per digit)
    Text {
        x: (dial_x(0deg, digit_radius) - digit_half) * 1px;
        y: (dial_y(0deg, digit_radius) - digit_half) * 1px;
        width: 2px * digit_half;
        height: self.width;
        text: "0";
        color: Theme.marking;
        font-size: 14px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
