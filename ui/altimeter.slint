// An altimeter with a 100 ft and a 1000 ft hand

import { Theme } from "theme.slint";

export component Altimeter inherits Rectangle {
    // altitude in feet
    in property <float> altitude: 0;

    property <length> size: min(self.width, self.height);
    property <length> outer_thickness: size * Theme.ring_ratio;
    property <float> size_float: size / 1px;
    // widths and font sizes are those of Theme at Theme.reference_size, scaled with the size of
    // the instrument, so it keeps its proportions on the desktop; exactly 1 on the device
    property <float> scale: size / Theme.reference_size;
    // font size on whole pixels: the device has glyphs of the sizes in Theme only, and a
    // fraction below them would fall back to the next smaller size
    property <length> large_font_size: round(Theme.large_font_size * scale / 1px) * 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    property <float> inner_radius: center - outer_thickness / 1px;
    // the digits sit in the middle of the ring
    property <float> digit_radius: center - outer_thickness / 2px;
    // half size of the box of a digit
    property <float> digit_half: outer_thickness / 2px;

    // Only the hands move. Every static part has a box that no hand box can reach, so moving
    // hands never make the ticks or digits be redrawn: the 100 ft hand is at most 0.74 of the
    // inner radius long, and the ticks are grouped so that no box of a group comes nearer to the
    // center than 0.79 of it (checked for all hand angles by tools/dial-paths.py).

    // direction of the hands as sine and cosine of their angle, clockwise from 12 o'clock
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the altitude.
    // one turn per 1000 ft (100 ft hand) and per 10000 ft (1000 ft hand), sin/cos make a
    // `mod()` unnecessary
    property <float> sin_100: sin_of(root.altitude * 0.36deg);
    property <float> cos_100: cos_of(root.altitude * 0.36deg);
    property <float> sin_1000: sin_of(root.altitude * 0.036deg);
    property <float> cos_1000: cos_of(root.altitude * 0.036deg);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // a point of a hand: `along` the hand from the center (negative is the tail) and `across`
    // it (positive is to the right of the hand when it points up)
    pure function hand_x(sin_a: float, cos_a: float, along: float, across: float) -> float {
        return center + along * sin_a + across * cos_a;
    }
    pure function hand_y(sin_a: float, cos_a: float, along: float, across: float) -> float {
        return center - along * cos_a + across * sin_a;
    }

    // a point on the dial at angle `a` (clockwise from 12 o'clock) and the given distance
    pure function dial_x(a: angle, distance: float) -> float {
        return center + distance * sin(a);
    }
    pure function dial_y(a: angle, distance: float) -> float {
        return center - distance * cos(a);
    }

    background: transparent;    // show background of parent

    // all parts in a square of `size`, centered in the area the instrument is given
    Rectangle {
        x: (root.width - root.size) / 2;
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;

        // outer ring, the digits are placed on it
        Rectangle {
            x: 0px;
            y: 0px;
            width: size;
            height: size;
            border-radius: size / 2;
            border-width: outer_thickness;
            border-color: Theme.bezel;
        }

        // Ticks every 20 ft, long and wide ones every 100 ft, ending at the ring (long ones at 0.85,
        // short ones at 0.92 of the inner radius). They are drawn as thin filled quadrilaterals
        // instead of strokes: a Path has only one stroke width, filled ticks of both sizes can share
        // a path, and fewer paths need less heap. The viewboxes are tight around the ticks (1 unit
        // margin), without a stroke the box is the viewbox.
        // Generated by tools/dial-paths.py, which also checks that no tick box overlaps a hand
        // box at any angle. The coordinates are `size_float * A + B` with precomputed A and B, so
        // each binding depends on one property only: the dependencies of bindings that use
        // `center`, `inner_radius` and functions cost about 16 KB more heap.
        // Run the script again after changing Theme.ring_ratio, Theme.marking_width or the hands.

        // BEGIN generated by tools/dial-paths.py, do not edit
        // 36deg, 43.2deg
        Path {
            viewbox-x: size_float * 0.694791 - 1.0000;
            viewbox-y: size_float * 0.172720 - 1.0000;
            viewbox-width: size_float * 0.081306 + 2.0000;
            viewbox-height: size_float * 0.061159 + 2.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: size_float * 0.694791;
                y: size_float * 0.221261;
            }

            LineTo {
                x: size_float * 0.730058;
                y: size_float * 0.172720;
            }

            LineTo {
                x: size_float * 0.740170;
                y: size_float * 0.180067;
            }

            LineTo {
                x: size_float * 0.704903;
                y: size_float * 0.228608;
            }

            Close { }

            MoveTo {
                x: size_float * 0.749635;
                y: size_float * 0.229600;
            }

            LineTo {
                x: size_float * 0.771541;
                y: size_float * 0.206273;
            }

            LineTo {
                x: size_float * 0.776097;
                y: size_float * 0.210552;
            }

            LineTo {
                x: size_float * 0.754191;
                y: size_float * 0.233879;
            }

