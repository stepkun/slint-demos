// A turn coordinator: rate of turn and slip

import { Theme } from "theme.slint";

export component TurnCoordinator inherits Rectangle {
    // rate of turn in degree per second, positive is a right turn
    in property <float> turn_rate: 0;
    // slip or skid, the position of the ball: -1 and 1 are the ends of the tube, positive right
    in property <float> slip: 0;

    property <length> size: min(self.width, self.height);
    property <length> outer_thickness: size * Theme.ring_ratio;
    property <float> size_float: size / 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    property <float> inner_radius: center - outer_thickness / 1px;
    // the labels sit in the middle of the ring
    property <float> label_radius: center - outer_thickness / 2px;
    property <float> label_half_width: outer_thickness * 0.46 / 1px;
    property <float> label_half_height: outer_thickness * 0.3 / 1px;

    // A standard rate turn (3 degree per second, a full circle in 2 minutes) banks the aircraft
    // symbol by 20 degree, onto the L and R marks. It stops at 6 degree per second (40 degree),
    // the same values as in tools/dial-paths.py.
    property <angle> bank: max(-6, min(6, root.turn_rate)) * 20deg / 3;

    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the bank.
    property <float> sin_bank: sin_of(bank);
    property <float> cos_bank: cos_of(bank);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // a point on the dial at angle `a` (clockwise from 12 o'clock) and the given distance
    pure function dial_x(a: angle, distance: float) -> float {
        return center + distance * sin(a);
    }
    pure function dial_y(a: angle, distance: float) -> float {
        return center - distance * cos(a);
    }

    // inclinometer: a straight tube below the aircraft symbol, from 0.66 to 0.80 of the inner
    // radius below the center and 0.42 of it to each side (the same as in tools/dial-paths.py)
    property <float> tube_half_width: inner_radius * 0.42;
    property <float> tube_top: center + inner_radius * 0.66;
    property <float> tube_height: inner_radius * 0.14;
    property <float> ball_radius: round(tube_height / 2 - 1);
    // the ball travels between the ends of the tube
    // Its box is on whole pixels: at a fractional position the anti-aliased edge of the round
    // Rectangle reaches pixels outside the redrawn region, which then keep an old value.
    property <float> ball_x: round(center + max(-1, min(1, root.slip)) * (tube_half_width - ball_radius - 1));

    background: transparent;    // show background of parent

    // outer ring, the labels are placed on it
    Rectangle {
        x: 0px;
        y: 0px;
        width: size;
        height: size;
        border-radius: size / 2;
        border-width: outer_thickness;
        border-color: Theme.bezel;
    }

    // Only the aircraft symbol and the ball move. The marks, the labels, the tube and the
    // "2 MIN" text have boxes that the box of the aircraft symbol never reaches at any bank
    // (checked by tools/dial-paths.py), so the moving symbol doesn't redraw them. The ball moves
    // inside the tube, but both are Rectangles, which are cheap to redraw, no paths.
    // Level marks at 9 and 3 o'clock, standard rate marks 20 degree below them, and the aircraft
    // symbol: its points are turned with the sine and cosine of the bank, written out in every
    // coordinate, so the compiler reads each property only once per path.
    // Generated by tools/dial-paths.py, run it again after changing the marks, the symbol, the
    // tube, Theme.ring_ratio or Theme.marking_width.

    // BEGIN generated by tools/dial-paths.py, do not edit
    // 270deg
    Path {
        viewbox-x: size_float * 0.100000 - 1.0000;
        viewbox-y: size_float * 0.500000 - 2.5000;
        viewbox-width: size_float * 0.060000 + 2.0000;
        viewbox-height: 5.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.160000;
            y: size_float * 0.500000 + 1.5000;
        }

        LineTo {
            x: size_float * 0.100000;
            y: size_float * 0.500000 + 1.5000;
        }

        LineTo {
            x: size_float * 0.100000;
            y: size_float * 0.500000 - 1.5000;
        }

        LineTo {
            x: size_float * 0.160000;
            y: size_float * 0.500000 - 1.5000;
        }

        Close { }
    }

    // 90deg
    Path {
        viewbox-x: size_float * 0.840000 - 1.0000;
        viewbox-y: size_float * 0.500000 - 2.5000;
        viewbox-width: size_float * 0.060000 + 2.0000;
        viewbox-height: 5.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.840000;
            y: size_float * 0.500000 - 1.5000;
        }

        LineTo {
            x: size_float * 0.900000;
            y: size_float * 0.500000 - 1.5000;
        }

        LineTo {
            x: size_float * 0.900000;
            y: size_float * 0.500000 + 1.5000;
        }

        LineTo {
            x: size_float * 0.840000;
            y: size_float * 0.500000 + 1.5000;
        }

        Close { }
    }

    // 250deg
    Path {
        viewbox-x: size_float * 0.124123 - 1.5130;
        viewbox-y: size_float * 0.616287 - 2.4095;
        viewbox-width: size_float * 0.056382 + 3.0261;
        viewbox-height: size_float * 0.020521 + 4.8191;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.180505 + 0.5130;
            y: size_float * 0.616287 + 1.4095;
        }

        LineTo {
            x: size_float * 0.124123 + 0.5130;
            y: size_float * 0.636808 + 1.4095;
        }

        LineTo {
            x: size_float * 0.124123 - 0.5130;
            y: size_float * 0.636808 - 1.4095;
        }

        LineTo {
            x: size_float * 0.180505 - 0.5130;
            y: size_float * 0.616287 - 1.4095;
        }

        Close { }
    }

    // 110deg
    Path {
        viewbox-x: size_float * 0.819495 - 1.5130;
        viewbox-y: size_float * 0.616287 - 2.4095;
        viewbox-width: size_float * 0.056382 + 3.0261;
        viewbox-height: size_float * 0.020521 + 4.8191;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.819495 + 0.5130;
            y: size_float * 0.616287 - 1.4095;
        }

        LineTo {
            x: size_float * 0.875877 + 0.5130;
            y: size_float * 0.636808 - 1.4095;
        }

        LineTo {
            x: size_float * 0.875877 - 0.5130;
            y: size_float * 0.636808 + 1.4095;
        }

        LineTo {
            x: size_float * 0.819495 - 0.5130;
            y: size_float * 0.616287 + 1.4095;
        }

        Close { }
    }

    // aircraft symbol, turns with the sin_bank/cos_bank angle, its box follows it
    Path {
        viewbox-x: center - (size_float * 0.280000) * abs(cos_bank) - (size_float * 0.088000) * abs(sin_bank) - 1;
        viewbox-y: center - (size_float * 0.280000) * abs(sin_bank) - (size_float * 0.088000) * abs(cos_bank) - 1;
        viewbox-width: 2 * ((size_float * 0.280000) * abs(cos_bank) + (size_float * 0.088000) * abs(sin_bank)) + 2;
        viewbox-height: 2 * ((size_float * 0.280000) * abs(sin_bank) + (size_float * 0.088000) * abs(cos_bank)) + 2;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: center + (size_float * -0.280000) * cos_bank - (size_float * -0.012000) * sin_bank;
            y: center + (size_float * -0.280000) * sin_bank + (size_float * -0.012000) * cos_bank;
        }

        LineTo {
            x: center + (size_float * 0.280000) * cos_bank - (size_float * -0.012000) * sin_bank;
            y: center + (size_float * 0.280000) * sin_bank + (size_float * -0.012000) * cos_bank;
        }

        LineTo {
            x: center + (size_float * 0.280000) * cos_bank - (size_float * 0.012000) * sin_bank;
            y: center + (size_float * 0.280000) * sin_bank + (size_float * 0.012000) * cos_bank;
        }

        LineTo {
            x: center + (size_float * -0.280000) * cos_bank - (size_float * 0.012000) * sin_bank;
            y: center + (size_float * -0.280000) * sin_bank + (size_float * 0.012000) * cos_bank;
        }

        Close { }

        MoveTo {
            x: center + (size_float * -0.010000) * cos_bank - (size_float * -0.088000) * sin_bank;
            y: center + (size_float * -0.010000) * sin_bank + (size_float * -0.088000) * cos_bank;
        }

        LineTo {
            x: center + (size_float * 0.010000) * cos_bank - (size_float * -0.088000) * sin_bank;
            y: center + (size_float * 0.010000) * sin_bank + (size_float * -0.088000) * cos_bank;
        }

        LineTo {
            x: center + (size_float * 0.010000) * cos_bank - (0.0000) * sin_bank;
            y: center + (size_float * 0.010000) * sin_bank + (0.0000) * cos_bank;
        }

        LineTo {
            x: center + (size_float * -0.010000) * cos_bank - (0.0000) * sin_bank;
            y: center + (size_float * -0.010000) * sin_bank + (0.0000) * cos_bank;
        }

        Close { }
    }

    // END generated by tools/dial-paths.py

    // fuselage of the aircraft symbol, round, so it doesn't change when the symbol turns
    Rectangle {
        x: (center - inner_radius * 0.09) * 1px;
        y: (center - inner_radius * 0.09) * 1px;
        width: inner_radius * 0.18 * 1px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.marking;
    }

    // L and R below the standard rate marks, in the ring
    Text {
        x: (dial_x(250deg, label_radius) - label_half_width) * 1px;
        y: (dial_y(250deg, label_radius) - label_half_height) * 1px;
        width: 2px * label_half_width;
        height: 2px * label_half_height;
        text: "L";
        color: Theme.marking;
        font-size: 12px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }

    Text {
        x: (dial_x(110deg, label_radius) - label_half_width) * 1px;
        y: (dial_y(110deg, label_radius) - label_half_height) * 1px;
        width: 2px * label_half_width;
        height: 2px * label_half_height;
        text: "R";
        color: Theme.marking;
        font-size: 12px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // a standard rate turn takes 2 minutes for a full circle
    Text {
        x: (center - inner_radius * 0.25) * 1px;
        y: (center + inner_radius * 0.81) * 1px;
        width: inner_radius * 0.5 * 1px;
        height: inner_radius * 0.18 * 1px;
        text: "2 MIN";
        color: Theme.marking;
        font-size: 12px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }

    // inclinometer tube
    Rectangle {
        x: (center - tube_half_width) * 1px;
        y: tube_top * 1px;
        width: 2px * tube_half_width;
        height: tube_height * 1px;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.marking;
        background: Theme.bezel;
    }

    // ball, only its own small box is redrawn when it moves
    Rectangle {
        x: (ball_x - ball_radius) * 1px;
        y: round(tube_top + tube_height / 2 - ball_radius) * 1px;
        width: 2px * ball_radius;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.marking;
    }

    // reference wires, the ball is centered between them in a coordinated turn
    Rectangle {
        x: (center - ball_radius - 2) * 1px;
        y: tube_top * 1px;
        width: 1px;
        height: tube_height * 1px;
        background: Theme.background;
    }

    Rectangle {
        x: (center + ball_radius + 1) * 1px;
        y: tube_top * 1px;
        width: 1px;
        height: tube_height * 1px;
        background: Theme.background;
    }
}
