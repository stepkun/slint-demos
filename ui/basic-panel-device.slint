// Test app for Instruments


import {
    Attitude,
    Altimeter,
    Airspeed,
    Heading,
    VerticalSpeed,
    TurnCoordinator,
    Theme,
} from "@aircraft-gauges/lib.slint";
// on MCUs there are no system fonts, so the font is embedded
import "@aircraft-gauges/fonts/NotoSans-Regular.ttf";

export component BasicPanelDevice inherits Window {
    // bank angle of the vehicle, positive is a right bank
    in property <angle> roll: 0deg;
    // pitch angle of the vehicle, positive is nose up
    in property <angle> pitch: 0deg;
    // altitude in feet
    in property <float> altitude: 0;
    // indicated airspeed in knots
    in property <float> airspeed: 0;
    // magnetic heading, 0deg is north
    in property <angle> heading: 0deg;
    // vertical speed in feet per minute, positive is climbing
    in property <float> vertical_speed: 0;
    // rate of turn in degree per second, positive is a right turn
    in property <float> turn_rate: 0;
    // slip or skid, the position of the ball: -1 and 1 are the ends of the tube, positive left
    in property <float> slip: 0;
    // shown instrument: 0 attitude indicator, 1 altimeter, 2 airspeed indicator,
    // 3 heading indicator, 4 vertical speed indicator, 5 turn coordinator
    // in-out, so the firmware can switch it while there is no touch input yet
    in-out property <int> instrument: 0;
    // default is the resolution of the waveshare rp2040 ResTouch 2.8" display
    in property <length> screen_width: 320px;
    in property <length> screen_height: 240px;
    // diagnostic text shown in the menu area, for example the frame rate
    in property <string> status;
    // backlight brightness in percent, set with the slider in the menu area (not below 5, a dark
    // display would look like a crash); the firmware sets the backlight from it
    in-out property <int> brightness: 100;
    // instruments shown one after the other (switch in the menu area), the application switches
    // them; selecting an instrument with a button turns it off
    in-out property <bool> auto_select: true;

    default-font-family: "Noto Sans";
    // the window fills the background, so no other element needs to
    background: Theme.background;

    // instrument that exists: follows `instrument` in two steps, through -1 (see below);
    // out, so tools/host-check can count the heap for the instrument that really exists
    out property <int> shown: 0;
    Timer {
        interval: 1ms;
        running: root.shown != root.instrument;
        triggered => {
            root.shown = root.shown < 0 ? root.instrument : -1;
        }
    }

    // the instrument is a square fitting the shorter screen side
    private property <bool> portrait: root.screen_height > root.screen_width;
    private property <length> instrument_size: min(root.screen_width, root.screen_height);
    Rectangle {
        width: root.screen_width;
        height: root.screen_height;

        // landscape: menu area on the left, portrait: below the instrument
        // selects the instrument to show
        // Only on a screen that leaves room for it: on a square one (the round RP2040-LCD-1.28,
        // without touch) its parts would stick out of the empty area into the instrument, and
        // it would take heap for nothing.
        if root.screen_width != root.screen_height: menu_area := Rectangle {
            background: Theme.menu;
            x: 0;
            y: root.portrait ? root.instrument_size : 0;
            width: root.portrait ? root.screen_width : root.screen_width - root.instrument_size;
            height: root.portrait ? root.screen_height - root.instrument_size : root.screen_height;

            Text {
                x: 4px;
                y: root.portrait ? 2px : 4px;
                width: parent.width - 8px;
                text: root.status;
                color: Theme.marking;
                font-size: Theme.menu_font_size;
                wrap: word-wrap;
            }

            // Controls between the status line and the buttons: in portrait side by side in one
            // row, in landscape stacked. Built from Rectangles and one TouchArea each instead of
            // the std-widgets, which cost much more heap on the RP2040. Moving parts are on whole
            // pixels, so their anti-aliased edges stay inside the redrawn region.

            // switch for the automatic sequence of instruments
            Rectangle {
                x: 4px;
                y: root.portrait ? 20px : 54px;
                width: root.portrait ? 64px : parent.width - 8px;
                height: root.portrait ? 22px : 20px;

                // track and knob, the knob is on the right while switched on
                Rectangle {
                    x: 0;
                    y: round((parent.height - self.height) / 2px) * 1px;
                    width: 28px;
                    height: 14px;
                    border-radius: self.height / 2;
                    background: root.auto_select ? Theme.selected : Theme.bezel;

                    Rectangle {
                        x: root.auto_select ? 16px : 2px;
                        y: 2px;
                        width: 10px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.marking;
                    }
                }

                Text {
                    x: 32px;
                    width: parent.width - self.x;
                    text: "AUTO";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.auto_select = !root.auto_select;
                    }
                }
            }

            // slider for the backlight brightness, from 5 % (left) to 100 % (right)
            Rectangle {
                // the knob center moves between `margin` and `width - margin`
                private property <length> margin: 6px;
                private property <float> value: (root.brightness - 5) / 95;

                x: root.portrait ? 72px : 4px;
                y: root.portrait ? 20px : 78px;
                width: root.portrait ? parent.width - 76px : parent.width - 8px;
                height: root.portrait ? 22px : 20px;

                // brightness from the touched position
                function set_from(position: length) {
                    root.brightness = round(5 + 95 * max(0, min(1, (position - self.margin) / (self.width - 2 * self.margin))));
                }

                // track
                Rectangle {
                    x: parent.margin;
                    y: round((parent.height - self.height) / 2px) * 1px;
                    width: parent.width - 2 * parent.margin;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.bezel;
                }

                // part of the track up to the knob
                Rectangle {
                    x: parent.margin;
                    y: round((parent.height - self.height) / 2px) * 1px;
                    width: round(parent.value * (parent.width - 2 * parent.margin) / 1px) * 1px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.selected;
                }

                // knob
                Rectangle {
                    x: round(parent.value * (parent.width - 2 * parent.margin) / 1px) * 1px;
                    y: round((parent.height - self.height) / 2px) * 1px;
                    width: 2 * parent.margin;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.marking;
                }

                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            parent.set_from(self.mouse-x);
                        }
                    }
                    moved => {
                        parent.set_from(self.mouse-x);
                    }
                }
            }

            // instrument selector at the bottom of the menu area: buttons side by side in
            // portrait, stacked in landscape, large enough to be hit with a finger
            // One frame, one highlight and one TouchArea for all buttons instead of a Rectangle
            // and TouchArea per button: every element and binding costs heap on the RP2040.
            // The order of the buttons is the order of the `instrument` values.
            Rectangle {
                private property <int> button_count: 6;
                // large enough for a finger on the display (portrait), shorter in landscape, so
                // all buttons fit below the status line and the controls
                private property <length> button_size: root.portrait ? 32px : 22px;
                private property <length> button_width: root.portrait ? self.width / self.button_count : self.width;
                // index of the touched button, from the position in the frame
                private property <int> touched: max(0, min(self.button_count - 1, floor(root.portrait ? touch.pressed-x / self.button_width : touch.pressed-y / self.button_size)));

                x: 4px;
                y: parent.height - self.height - 4px;
                width: parent.width - 8px;
                height: root.portrait ? self.button_size : self.button_count * self.button_size;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.marking;

                // highlight of the selected button
                Rectangle {
                    x: root.portrait ? root.instrument * parent.button_width : 0;
                    y: root.portrait ? 0 : root.instrument * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    border-radius: 4px;
                    background: Theme.selected;
                }

                Text {
                    x: root.portrait ? 0 * parent.button_width : 0;
                    y: root.portrait ? 0 : 0 * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    text: "ATT";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    x: root.portrait ? 1 * parent.button_width : 0;
                    y: root.portrait ? 0 : 1 * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    text: "ALT";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    x: root.portrait ? 2 * parent.button_width : 0;
                    y: root.portrait ? 0 : 2 * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    text: "IAS";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    x: root.portrait ? 3 * parent.button_width : 0;
                    y: root.portrait ? 0 : 3 * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    text: "HDG";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    x: root.portrait ? 4 * parent.button_width : 0;
                    y: root.portrait ? 0 : 4 * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    text: "VSI";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    x: root.portrait ? 5 * parent.button_width : 0;
                    y: root.portrait ? 0 : 5 * parent.button_size;
                    width: parent.button_width;
                    height: parent.button_size;
                    text: "TC";
                    color: Theme.marking;
                    font-size: Theme.menu_font_size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touch := TouchArea {
                    clicked => {
                        root.instrument = parent.touched;
                        // a selected instrument stays, the automatic sequence would replace it
                        root.auto_select = false;
                    }
                }
            }
        }

        // landscape: instrument area on the right, portrait: on top
        // shows the selected instrument
        instrument_area := Rectangle {
            x: root.portrait ? 0 : root.screen_width - root.instrument_size;
            y: 0;
            width: root.instrument_size;
            height: root.instrument_size;

            // only the shown instrument exists, so only its elements take heap
            // The `if`s are updated in the order they are written: switched to an instrument
            // written above the shown one, the new one would be created before the old one is
            // destroyed, and both together don't fit into the heap of the device (airspeed and
            // altimeter: 65 KB requested). So the old one is removed first: `shown` is -1 for
            // one frame, then the new instrument.
            if root.shown == 0: Attitude {
                roll: root.roll;
                pitch: root.pitch;
            }

            if root.shown == 1: Altimeter {
                altitude: root.altitude;
            }

            if root.shown == 2: Airspeed {
                airspeed: root.airspeed;
            }

            if root.shown == 3: Heading {
                heading: root.heading;
            }

            if root.shown == 4: VerticalSpeed {
                vertical_speed: root.vertical_speed;
            }

            if root.shown == 5: TurnCoordinator {
                turn_rate: root.turn_rate;
                slip: root.slip;
            }
        }
    }
}
