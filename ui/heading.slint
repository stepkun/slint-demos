// A heading indicator: a compass card that turns under a fixed heading mark

import { Theme } from "theme.slint";

export component Heading inherits Rectangle {
    // magnetic heading, 0deg is north, positive clockwise
    in property <angle> heading: 0deg;

    property <length> size: min(self.width, self.height);
    property <float> size_float: size / 1px;
    // widths and font sizes are those of Theme at Theme.reference_size, scaled with the size of
    // the instrument, so it keeps its proportions on the desktop; exactly 1 on the device
    property <float> scale: size / Theme.reference_size;
    // font size on whole pixels: the device has glyphs of the sizes in Theme only, and a
    // fraction below them would fall back to the next smaller size
    property <length> large_font_size: round(Theme.large_font_size * scale / 1px) * 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    // No bezel ring: the card reaches almost to the edge of the instrument, its inner radius is
    // 0.49 of the size (0.5 - RING_RATIO of the heading dial in tools/dial-paths.py).
    // large enough for two digits in Theme.large_font_size, the device clips text to its box
    property <float> label_half_width: size_float * 0.06;
    property <float> label_half_height: size_float * 0.045;

    // The whole card turns, so the card is redrawn every frame, like the inner disc of the
    // attitude indicator. The software renderer can't rotate, so every point of the card is
    // turned with the sine and cosine of the heading. The labels stay upright, text can't be
    // rotated either.
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the heading.
    property <float> sin_heading: sin_of(root.heading);
    property <float> cos_heading: cos_of(root.heading);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // A point of the card at offset (px, py) from the center with north up is turned by the
    // heading against the clock, so the current heading is at the top:
    //   x = center + px * cos_heading + py * sin_heading
    //   y = center - px * sin_heading + py * cos_heading
    // This is written out in every coordinate instead of calling a function: the compiler then
    // reads each property once per path; in a function it reads them again for every call,
    // inlines the sine and cosine into it, and each read costs a dependency node of heap.

    background: transparent;    // show background of parent

    // all parts in a square of `size`, centered in the area the instrument is given
    Rectangle {
        x: (root.width - root.size) / 2;
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;

        // Card: ticks every 5 degree, long and wide ones every 10 degree, almost to the edge, and
        // labels every 30 degree. The ticks are thin filled quadrilaterals in eight paths, whose box
        // is the whole card: the ticks move around all of it. Each path rebuilds its elements every
        // frame, eight small paths keep these blocks small (about 1.3 KB, a single path would need
        // 10 KB), so they are still found when the heap is fragmented, and a band of a path stays
        // within the rasterizer cells the renderer reserves. A path has a single fill, so the
        // orange ticks of N, E, S and W are a ninth path. The coordinates on the card are
        // precomputed, per frame each corner only needs the sine and cosine of the heading.
        // Fixed parts, red: the heading mark and the marks at 3, 6 and 9 o'clock lie over the outer
        // ends of the card ticks, the aircraft symbol in the middle. They are small and redrawn
        // with the turning card, drawn after it so they stay on top.
        // Generated by tools/dial-paths.py. Run it again after changing the card, the size of the
        // dial or Theme.marking_width.

        // BEGIN generated by tools/dial-paths.py, do not edit
        // card ticks 5deg to 45deg, they turn with the card
        Path {
            viewbox-x: size_float * 0.010000 - 2.5000;
            viewbox-y: size_float * 0.010000 - 2.5000;
            viewbox-width: size_float * 0.980000 + 5.0000;
            viewbox-height: size_float * 0.980000 + 5.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: center + (size_float * 0.036177) * cos_heading + (size_float * -0.449357) * sin_heading;
                y: center - (size_float * 0.036177) * sin_heading + (size_float * -0.449357) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.039593) * cos_heading + (size_float * -0.488408) * sin_heading;
                y: center - (size_float * 0.039593) * sin_heading + (size_float * -0.488408) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.045819) * cos_heading + (size_float * -0.487863) * sin_heading;
                y: center - (size_float * 0.045819) * sin_heading + (size_float * -0.487863) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.042403) * cos_heading + (size_float * -0.448812) * sin_heading;
                y: center - (size_float * 0.042403) * sin_heading + (size_float * -0.448812) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.066169) * cos_heading + (size_float * -0.411258) * sin_heading;
                y: center - (size_float * 0.066169) * sin_heading + (size_float * -0.411258) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.078933) * cos_heading + (size_float * -0.483641) * sin_heading;
                y: center - (size_float * 0.078933) * sin_heading + (size_float * -0.483641) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.091243) * cos_heading + (size_float * -0.481470) * sin_heading;
                y: center - (size_float * 0.091243) * sin_heading + (size_float * -0.481470) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.078480) * cos_heading + (size_float * -0.409087) * sin_heading;
                y: center - (size_float * 0.078480) * sin_heading + (size_float * -0.409087) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.113657) * cos_heading + (size_float * -0.436248) * sin_heading;
                y: center - (size_float * 0.113657) * sin_heading + (size_float * -0.436248) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.123803) * cos_heading + (size_float * -0.474112) * sin_heading;
                y: center - (size_float * 0.123803) * sin_heading + (size_float * -0.474112) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.129840) * cos_heading + (size_float * -0.472495) * sin_heading;
                y: center - (size_float * 0.129840) * sin_heading + (size_float * -0.472495) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.119694) * cos_heading + (size_float * -0.434631) * sin_heading;
                y: center - (size_float * 0.119694) * sin_heading + (size_float * -0.434631) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.136578) * cos_heading + (size_float * -0.393520) * sin_heading;
                y: center - (size_float * 0.136578) * sin_heading + (size_float * -0.393520) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.161717) * cos_heading + (size_float * -0.462587) * sin_heading;
                y: center - (size_float * 0.161717) * sin_heading + (size_float * -0.462587) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.173463) * cos_heading + (size_float * -0.458312) * sin_heading;
                y: center - (size_float * 0.173463) * sin_heading + (size_float * -0.458312) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.148324) * cos_heading + (size_float * -0.389244) * sin_heading;
                y: center - (size_float * 0.148324) * sin_heading + (size_float * -0.389244) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.187684) * cos_heading + (size_float * -0.409884) * sin_heading;
                y: center - (size_float * 0.187684) * sin_heading + (size_float * -0.409884) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.204251) * cos_heading + (size_float * -0.445411) * sin_heading;
                y: center - (size_float * 0.204251) * sin_heading + (size_float * -0.445411) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.209915) * cos_heading + (size_float * -0.442770) * sin_heading;
                y: center - (size_float * 0.209915) * sin_heading + (size_float * -0.442770) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.193349) * cos_heading + (size_float * -0.407243) * sin_heading;
                y: center - (size_float * 0.193349) * sin_heading + (size_float * -0.407243) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.202837) * cos_heading + (size_float * -0.363825) * sin_heading;
                y: center - (size_float * 0.202837) * sin_heading + (size_float * -0.363825) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.239587) * cos_heading + (size_float * -0.427477) * sin_heading;
                y: center - (size_float * 0.239587) * sin_heading + (size_float * -0.427477) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.250413) * cos_heading + (size_float * -0.421227) * sin_heading;
                y: center - (size_float * 0.250413) * sin_heading + (size_float * -0.421227) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.213663) * cos_heading + (size_float * -0.357575) * sin_heading;
                y: center - (size_float * 0.213663) * sin_heading + (size_float * -0.357575) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.256008) * cos_heading + (size_float * -0.371066) * sin_heading;
                y: center - (size_float * 0.256008) * sin_heading + (size_float * -0.371066) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.278493) * cos_heading + (size_float * -0.403177) * sin_heading;
                y: center - (size_float * 0.278493) * sin_heading + (size_float * -0.403177) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.283612) * cos_heading + (size_float * -0.399592) * sin_heading;
                y: center - (size_float * 0.283612) * sin_heading + (size_float * -0.399592) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.261128) * cos_heading + (size_float * -0.367481) * sin_heading;
                y: center - (size_float * 0.261128) * sin_heading + (size_float * -0.367481) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.262933) * cos_heading + (size_float * -0.323075) * sin_heading;
                y: center - (size_float * 0.262933) * sin_heading + (size_float * -0.323075) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.310178) * cos_heading + (size_float * -0.379379) * sin_heading;
                y: center - (size_float * 0.310178) * sin_heading + (size_float * -0.379379) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.319754) * cos_heading + (size_float * -0.371344) * sin_heading;
                y: center - (size_float * 0.319754) * sin_heading + (size_float * -0.371344) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.272509) * cos_heading + (size_float * -0.315040) * sin_heading;
                y: center - (size_float * 0.272509) * sin_heading + (size_float * -0.315040) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.316554) * cos_heading + (size_float * -0.320973) * sin_heading;
                y: center - (size_float * 0.316554) * sin_heading + (size_float * -0.320973) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.344273) * cos_heading + (size_float * -0.348692) * sin_heading;
                y: center - (size_float * 0.344273) * sin_heading + (size_float * -0.348692) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.348692) * cos_heading + (size_float * -0.344273) * sin_heading;
                y: center - (size_float * 0.348692) * sin_heading + (size_float * -0.344273) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.320973) * cos_heading + (size_float * -0.316554) * sin_heading;
                y: center - (size_float * 0.320973) * sin_heading + (size_float * -0.316554) * cos_heading;
            }

            Close { }
        }

        // card ticks 50deg to 95deg, they turn with the card
        Path {
            viewbox-x: size_float * 0.010000 - 2.5000;
            viewbox-y: size_float * 0.010000 - 2.5000;
            viewbox-width: size_float * 0.980000 + 5.0000;
            viewbox-height: size_float * 0.980000 + 5.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: center + (size_float * 0.315040) * cos_heading + (size_float * -0.272509) * sin_heading;
                y: center - (size_float * 0.315040) * sin_heading + (size_float * -0.272509) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.371344) * cos_heading + (size_float * -0.319754) * sin_heading;
                y: center - (size_float * 0.371344) * sin_heading + (size_float * -0.319754) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.379379) * cos_heading + (size_float * -0.310178) * sin_heading;
                y: center - (size_float * 0.379379) * sin_heading + (size_float * -0.310178) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.323075) * cos_heading + (size_float * -0.262933) * sin_heading;
                y: center - (size_float * 0.323075) * sin_heading + (size_float * -0.262933) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.367481) * cos_heading + (size_float * -0.261128) * sin_heading;
                y: center - (size_float * 0.367481) * sin_heading + (size_float * -0.261128) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.399592) * cos_heading + (size_float * -0.283612) * sin_heading;
                y: center - (size_float * 0.399592) * sin_heading + (size_float * -0.283612) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.403177) * cos_heading + (size_float * -0.278493) * sin_heading;
                y: center - (size_float * 0.403177) * sin_heading + (size_float * -0.278493) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.371066) * cos_heading + (size_float * -0.256008) * sin_heading;
                y: center - (size_float * 0.371066) * sin_heading + (size_float * -0.256008) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.357575) * cos_heading + (size_float * -0.213663) * sin_heading;
                y: center - (size_float * 0.357575) * sin_heading + (size_float * -0.213663) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.421227) * cos_heading + (size_float * -0.250413) * sin_heading;
                y: center - (size_float * 0.421227) * sin_heading + (size_float * -0.250413) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.427477) * cos_heading + (size_float * -0.239587) * sin_heading;
                y: center - (size_float * 0.427477) * sin_heading + (size_float * -0.239587) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.363825) * cos_heading + (size_float * -0.202837) * sin_heading;
                y: center - (size_float * 0.363825) * sin_heading + (size_float * -0.202837) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.407243) * cos_heading + (size_float * -0.193349) * sin_heading;
                y: center - (size_float * 0.407243) * sin_heading + (size_float * -0.193349) * cos_heading;
            }

            LineTo {
