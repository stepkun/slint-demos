// A heading indicator: a compass card that turns under a fixed heading mark

import { Theme } from "theme.slint";

export component Heading inherits Rectangle {
    // magnetic heading, 0deg is north, positive clockwise
    in property <angle> heading: 0deg;

    property <length> size: min(self.width, self.height);
    property <length> outer_thickness: size * Theme.ring_ratio;
    property <float> size_float: size / 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    property <float> label_half_width: outer_thickness * 0.5 / 1px;
    property <float> label_half_height: outer_thickness * 0.35 / 1px;

    // The whole card turns, so the card is redrawn every frame, like the inner disc of the
    // attitude indicator. The software renderer can't rotate, so every point of the card is
    // turned with the sine and cosine of the heading. The labels stay upright, text can't be
    // rotated either.
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the heading.
    property <float> sin_heading: sin_of(root.heading);
    property <float> cos_heading: cos_of(root.heading);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // A point of the card at offset (px, py) from the center with north up is turned by the
    // heading against the clock, so the current heading is at the top:
    //   x = center + px * cos_heading + py * sin_heading
    //   y = center - px * sin_heading + py * cos_heading
    // This is written out in every coordinate instead of calling a function: the compiler then
    // reads each property once per path; in a function it reads them again for every call,
    // inlines the sine and cosine into it, and each read costs a dependency node of heap.

    background: transparent;    // show background of parent

    // outer ring, the fixed marks are placed on it
    Rectangle {
        x: 0px;
        y: 0px;
        width: size;
        height: size;
        border-radius: size / 2;
        border-width: outer_thickness;
        border-color: Theme.bezel;
    }

    // Card: ticks every 5 degree, long and wide ones every 10 degree, ending at the ring, and
    // labels every 30 degree. The ticks are thin filled quadrilaterals in eight paths, whose box
    // is the whole card: the ticks move around all of it. Each path rebuilds its elements every
    // frame, eight small paths keep these blocks small (about 1.3 KB, a single path would need
    // 10 KB), so they are still found when the heap is fragmented, and a band of a path stays
    // within the rasterizer cells the renderer reserves. A path has a single fill, so the
    // orange ticks of N, E, S and W are a ninth path. The coordinates on the card are
    // precomputed, per frame each corner only needs the sine and cosine of the heading.
    // Fixed parts: the heading mark and the marks at 3, 6 and 9 o'clock lie in the ring,
    // outside the box of the card, so the turning card doesn't redraw them. Only the aircraft
    // symbol lies over the card, it is small and redrawn with it.
    // Generated by tools/dial-paths.py, which also checks that the fixed marks stay outside the
    // box of the card. Run it again after changing the card, Theme.ring_ratio or
    // Theme.marking_width.

    // BEGIN generated by tools/dial-paths.py, do not edit
    // card ticks 5deg to 45deg, they turn with the card
    Path {
        viewbox-x: size_float * 0.100000 - 2.5000;
        viewbox-y: size_float * 0.100000 - 2.5000;
        viewbox-width: size_float * 0.800000 + 5.0000;
        viewbox-height: size_float * 0.800000 + 5.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: center + (size_float * 0.032073 - 0.7471) * cos_heading + (size_float * -0.366600 - 0.0654) * sin_heading;
            y: center - (size_float * 0.032073 - 0.7471) * sin_heading + (size_float * -0.366600 - 0.0654) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.034862 - 0.7471) * cos_heading + (size_float * -0.398478 - 0.0654) * sin_heading;
            y: center - (size_float * 0.034862 - 0.7471) * sin_heading + (size_float * -0.398478 - 0.0654) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.034862 + 0.7471) * cos_heading + (size_float * -0.398478 + 0.0654) * sin_heading;
            y: center - (size_float * 0.034862 + 0.7471) * sin_heading + (size_float * -0.398478 + 0.0654) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.032073 + 0.7471) * cos_heading + (size_float * -0.366600 + 0.0654) * sin_heading;
            y: center - (size_float * 0.032073 + 0.7471) * sin_heading + (size_float * -0.366600 + 0.0654) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.059040 - 1.4772) * cos_heading + (size_float * -0.334835 - 0.2605) * sin_heading;
            y: center - (size_float * 0.059040 - 1.4772) * sin_heading + (size_float * -0.334835 - 0.2605) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.069459 - 1.4772) * cos_heading + (size_float * -0.393923 - 0.2605) * sin_heading;
            y: center - (size_float * 0.069459 - 1.4772) * sin_heading + (size_float * -0.393923 - 0.2605) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.069459 + 1.4772) * cos_heading + (size_float * -0.393923 + 0.2605) * sin_heading;
            y: center - (size_float * 0.069459 + 1.4772) * sin_heading + (size_float * -0.393923 + 0.2605) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.059040 + 1.4772) * cos_heading + (size_float * -0.334835 + 0.2605) * sin_heading;
            y: center - (size_float * 0.059040 + 1.4772) * sin_heading + (size_float * -0.334835 + 0.2605) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.095245 - 0.7244) * cos_heading + (size_float * -0.355461 - 0.1941) * sin_heading;
            y: center - (size_float * 0.095245 - 0.7244) * sin_heading + (size_float * -0.355461 - 0.1941) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.103528 - 0.7244) * cos_heading + (size_float * -0.386370 - 0.1941) * sin_heading;
            y: center - (size_float * 0.103528 - 0.7244) * sin_heading + (size_float * -0.386370 - 0.1941) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.103528 + 0.7244) * cos_heading + (size_float * -0.386370 + 0.1941) * sin_heading;
            y: center - (size_float * 0.103528 + 0.7244) * sin_heading + (size_float * -0.386370 + 0.1941) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.095245 + 0.7244) * cos_heading + (size_float * -0.355461 + 0.1941) * sin_heading;
            y: center - (size_float * 0.095245 + 0.7244) * sin_heading + (size_float * -0.355461 + 0.1941) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.116287 - 1.4095) * cos_heading + (size_float * -0.319495 - 0.5130) * sin_heading;
            y: center - (size_float * 0.116287 - 1.4095) * sin_heading + (size_float * -0.319495 - 0.5130) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.136808 - 1.4095) * cos_heading + (size_float * -0.375877 - 0.5130) * sin_heading;
            y: center - (size_float * 0.136808 - 1.4095) * sin_heading + (size_float * -0.375877 - 0.5130) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.136808 + 1.4095) * cos_heading + (size_float * -0.375877 + 0.5130) * sin_heading;
            y: center - (size_float * 0.136808 + 1.4095) * sin_heading + (size_float * -0.375877 + 0.5130) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.116287 + 1.4095) * cos_heading + (size_float * -0.319495 + 0.5130) * sin_heading;
            y: center - (size_float * 0.116287 + 1.4095) * sin_heading + (size_float * -0.319495 + 0.5130) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.155524 - 0.6797) * cos_heading + (size_float * -0.333521 - 0.3170) * sin_heading;
            y: center - (size_float * 0.155524 - 0.6797) * sin_heading + (size_float * -0.333521 - 0.3170) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.169047 - 0.6797) * cos_heading + (size_float * -0.362523 - 0.3170) * sin_heading;
            y: center - (size_float * 0.169047 - 0.6797) * sin_heading + (size_float * -0.362523 - 0.3170) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.169047 + 0.6797) * cos_heading + (size_float * -0.362523 + 0.3170) * sin_heading;
            y: center - (size_float * 0.169047 + 0.6797) * sin_heading + (size_float * -0.362523 + 0.3170) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.155524 + 0.6797) * cos_heading + (size_float * -0.333521 + 0.3170) * sin_heading;
            y: center - (size_float * 0.155524 + 0.6797) * sin_heading + (size_float * -0.333521 + 0.3170) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.170000 - 1.2990) * cos_heading + (size_float * -0.294449 - 0.7500) * sin_heading;
            y: center - (size_float * 0.170000 - 1.2990) * sin_heading + (size_float * -0.294449 - 0.7500) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.200000 - 1.2990) * cos_heading + (size_float * -0.346410 - 0.7500) * sin_heading;
            y: center - (size_float * 0.200000 - 1.2990) * sin_heading + (size_float * -0.346410 - 0.7500) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.200000 + 1.2990) * cos_heading + (size_float * -0.346410 + 0.7500) * sin_heading;
            y: center - (size_float * 0.200000 + 1.2990) * sin_heading + (size_float * -0.346410 + 0.7500) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.170000 + 1.2990) * cos_heading + (size_float * -0.294449 + 0.7500) * sin_heading;
            y: center - (size_float * 0.170000 + 1.2990) * sin_heading + (size_float * -0.294449 + 0.7500) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.211076 - 0.6144) * cos_heading + (size_float * -0.301448 - 0.4302) * sin_heading;
            y: center - (size_float * 0.211076 - 0.6144) * sin_heading + (size_float * -0.301448 - 0.4302) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.229431 - 0.6144) * cos_heading + (size_float * -0.327661 - 0.4302) * sin_heading;
            y: center - (size_float * 0.229431 - 0.6144) * sin_heading + (size_float * -0.327661 - 0.4302) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.229431 + 0.6144) * cos_heading + (size_float * -0.327661 + 0.4302) * sin_heading;
            y: center - (size_float * 0.229431 + 0.6144) * sin_heading + (size_float * -0.327661 + 0.4302) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.211076 + 0.6144) * cos_heading + (size_float * -0.301448 + 0.4302) * sin_heading;
            y: center - (size_float * 0.211076 + 0.6144) * sin_heading + (size_float * -0.301448 + 0.4302) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.218548 - 1.1491) * cos_heading + (size_float * -0.260455 - 0.9642) * sin_heading;
            y: center - (size_float * 0.218548 - 1.1491) * sin_heading + (size_float * -0.260455 - 0.9642) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.257115 - 1.1491) * cos_heading + (size_float * -0.306418 - 0.9642) * sin_heading;
            y: center - (size_float * 0.257115 - 1.1491) * sin_heading + (size_float * -0.306418 - 0.9642) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.257115 + 1.1491) * cos_heading + (size_float * -0.306418 + 0.9642) * sin_heading;
            y: center - (size_float * 0.257115 + 1.1491) * sin_heading + (size_float * -0.306418 + 0.9642) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.218548 + 1.1491) * cos_heading + (size_float * -0.260455 + 0.9642) * sin_heading;
            y: center - (size_float * 0.218548 + 1.1491) * sin_heading + (size_float * -0.260455 + 0.9642) * cos_heading;
        }

        Close { }

        MoveTo {
            x: center + (size_float * 0.260215 - 0.5303) * cos_heading + (size_float * -0.260215 - 0.5303) * sin_heading;
            y: center - (size_float * 0.260215 - 0.5303) * sin_heading + (size_float * -0.260215 - 0.5303) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.282843 - 0.5303) * cos_heading + (size_float * -0.282843 - 0.5303) * sin_heading;
            y: center - (size_float * 0.282843 - 0.5303) * sin_heading + (size_float * -0.282843 - 0.5303) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.282843 + 0.5303) * cos_heading + (size_float * -0.282843 + 0.5303) * sin_heading;
            y: center - (size_float * 0.282843 + 0.5303) * sin_heading + (size_float * -0.282843 + 0.5303) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.260215 + 0.5303) * cos_heading + (size_float * -0.260215 + 0.5303) * sin_heading;
            y: center - (size_float * 0.260215 + 0.5303) * sin_heading + (size_float * -0.260215 + 0.5303) * cos_heading;
        }

        Close { }
    }

    // card ticks 50deg to 95deg, they turn with the card
    Path {
        viewbox-x: size_float * 0.100000 - 2.5000;
        viewbox-y: size_float * 0.100000 - 2.5000;
        viewbox-width: size_float * 0.800000 + 5.0000;
        viewbox-height: size_float * 0.800000 + 5.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: center + (size_float * 0.260455 - 0.9642) * cos_heading + (size_float * -0.218548 - 1.1491) * sin_heading;
            y: center - (size_float * 0.260455 - 0.9642) * sin_heading + (size_float * -0.218548 - 1.1491) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.306418 - 0.9642) * cos_heading + (size_float * -0.257115 - 1.1491) * sin_heading;
            y: center - (size_float * 0.306418 - 0.9642) * sin_heading + (size_float * -0.257115 - 1.1491) * cos_heading;
        }

        LineTo {
            x: center + (size_float * 0.306418 + 0.9642) * cos_heading + (size_float * -0.257115 + 1.1491) * sin_heading;
            y: center - (size_float * 0.306418 + 0.9642) * sin_heading + (size_float * -0.257115 + 1.1491) * cos_heading;
