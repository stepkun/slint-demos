// A heading indicator: a compass card that turns under a fixed heading mark

import { Theme } from "theme.slint";

export component Heading inherits Rectangle {
    // magnetic heading, 0deg is north, positive clockwise
    in property <angle> heading: 0deg;

    property <length> size: min(self.width, self.height);
    property <length> outer_thickness: size * Theme.ring_ratio;
    property <float> size_float: size / 1px;
    // widths and font sizes are those of Theme at Theme.reference_size, scaled with the size of
    // the instrument, so it keeps its proportions on the desktop; exactly 1 on the device
    property <float> scale: size / Theme.reference_size;
    // font size on whole pixels: the device has glyphs of the sizes in Theme only, and a
    // fraction below them would fall back to the next smaller size
    property <length> large_font_size: round(Theme.large_font_size * scale / 1px) * 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    property <float> label_half_width: outer_thickness * 0.5 / 1px;
    property <float> label_half_height: outer_thickness * 0.35 / 1px;

    // The whole card turns, so the card is redrawn every frame, like the inner disc of the
    // attitude indicator. The software renderer can't rotate, so every point of the card is
    // turned with the sine and cosine of the heading. The labels stay upright, text can't be
    // rotated either.
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the heading.
    property <float> sin_heading: sin_of(root.heading);
    property <float> cos_heading: cos_of(root.heading);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // A point of the card at offset (px, py) from the center with north up is turned by the
    // heading against the clock, so the current heading is at the top:
    //   x = center + px * cos_heading + py * sin_heading
    //   y = center - px * sin_heading + py * cos_heading
    // This is written out in every coordinate instead of calling a function: the compiler then
    // reads each property once per path; in a function it reads them again for every call,
    // inlines the sine and cosine into it, and each read costs a dependency node of heap.

    background: transparent;    // show background of parent

    // all parts in a square of `size`, centered in the area the instrument is given
    Rectangle {
        x: (root.width - root.size) / 2;
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;

        // outer ring, the fixed marks are placed on it
        Rectangle {
            x: 0px;
            y: 0px;
            width: size;
            height: size;
            border-radius: size / 2;
            border-width: outer_thickness;
            border-color: Theme.bezel;
        }

        // Card: ticks every 5 degree, long and wide ones every 10 degree, ending at the ring, and
        // labels every 30 degree. The ticks are thin filled quadrilaterals in eight paths, whose box
        // is the whole card: the ticks move around all of it. Each path rebuilds its elements every
        // frame, eight small paths keep these blocks small (about 1.3 KB, a single path would need
        // 10 KB), so they are still found when the heap is fragmented, and a band of a path stays
        // within the rasterizer cells the renderer reserves. A path has a single fill, so the
        // orange ticks of N, E, S and W are a ninth path. The coordinates on the card are
        // precomputed, per frame each corner only needs the sine and cosine of the heading.
        // Fixed parts: the heading mark and the marks at 3, 6 and 9 o'clock lie in the ring,
        // outside the box of the card, so the turning card doesn't redraw them. Only the aircraft
        // symbol lies over the card, it is small and redrawn with it.
        // Generated by tools/dial-paths.py, which also checks that the fixed marks stay outside the
        // box of the card. Run it again after changing the card, Theme.ring_ratio or
        // Theme.marking_width.

        // BEGIN generated by tools/dial-paths.py, do not edit
        // card ticks 5deg to 45deg, they turn with the card
        Path {
            viewbox-x: size_float * 0.100000 - 2.5000;
            viewbox-y: size_float * 0.100000 - 2.5000;
            viewbox-width: size_float * 0.800000 + 5.0000;
            viewbox-height: size_float * 0.800000 + 5.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: center + (size_float * 0.028960) * cos_heading + (size_float * -0.366872) * sin_heading;
                y: center - (size_float * 0.028960) * sin_heading + (size_float * -0.366872) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.031749) * cos_heading + (size_float * -0.398750) * sin_heading;
                y: center - (size_float * 0.031749) * sin_heading + (size_float * -0.398750) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.037975) * cos_heading + (size_float * -0.398206) * sin_heading;
                y: center - (size_float * 0.037975) * sin_heading + (size_float * -0.398206) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.035186) * cos_heading + (size_float * -0.366327) * sin_heading;
                y: center - (size_float * 0.035186) * sin_heading + (size_float * -0.366327) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.052885) * cos_heading + (size_float * -0.335920) * sin_heading;
                y: center - (size_float * 0.052885) * sin_heading + (size_float * -0.335920) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.063304) * cos_heading + (size_float * -0.395008) * sin_heading;
                y: center - (size_float * 0.063304) * sin_heading + (size_float * -0.395008) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.075614) * cos_heading + (size_float * -0.392838) * sin_heading;
                y: center - (size_float * 0.075614) * sin_heading + (size_float * -0.392838) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.065195) * cos_heading + (size_float * -0.333749) * sin_heading;
                y: center - (size_float * 0.065195) * sin_heading + (size_float * -0.333749) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.092227) * cos_heading + (size_float * -0.356270) * sin_heading;
                y: center - (size_float * 0.092227) * sin_heading + (size_float * -0.356270) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.100509) * cos_heading + (size_float * -0.387179) * sin_heading;
                y: center - (size_float * 0.100509) * sin_heading + (size_float * -0.387179) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.106546) * cos_heading + (size_float * -0.385562) * sin_heading;
                y: center - (size_float * 0.106546) * sin_heading + (size_float * -0.385562) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.098264) * cos_heading + (size_float * -0.354652) * sin_heading;
                y: center - (size_float * 0.098264) * sin_heading + (size_float * -0.354652) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.110414) * cos_heading + (size_float * -0.321633) * sin_heading;
                y: center - (size_float * 0.110414) * sin_heading + (size_float * -0.321633) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.130935) * cos_heading + (size_float * -0.378015) * sin_heading;
                y: center - (size_float * 0.130935) * sin_heading + (size_float * -0.378015) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.142681) * cos_heading + (size_float * -0.373739) * sin_heading;
                y: center - (size_float * 0.142681) * sin_heading + (size_float * -0.373739) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.122160) * cos_heading + (size_float * -0.317358) * sin_heading;
                y: center - (size_float * 0.122160) * sin_heading + (size_float * -0.317358) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.152691) * cos_heading + (size_float * -0.334842) * sin_heading;
                y: center - (size_float * 0.152691) * sin_heading + (size_float * -0.334842) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.166215) * cos_heading + (size_float * -0.363844) * sin_heading;
                y: center - (size_float * 0.166215) * sin_heading + (size_float * -0.363844) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.171880) * cos_heading + (size_float * -0.361202) * sin_heading;
                y: center - (size_float * 0.171880) * sin_heading + (size_float * -0.361202) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.158356) * cos_heading + (size_float * -0.332201) * sin_heading;
                y: center - (size_float * 0.158356) * sin_heading + (size_float * -0.332201) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.164587) * cos_heading + (size_float * -0.297574) * sin_heading;
                y: center - (size_float * 0.164587) * sin_heading + (size_float * -0.297574) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.194587) * cos_heading + (size_float * -0.349535) * sin_heading;
                y: center - (size_float * 0.194587) * sin_heading + (size_float * -0.349535) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.205413) * cos_heading + (size_float * -0.343285) * sin_heading;
                y: center - (size_float * 0.205413) * sin_heading + (size_float * -0.343285) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.175413) * cos_heading + (size_float * -0.291324) * sin_heading;
                y: center - (size_float * 0.175413) * sin_heading + (size_float * -0.291324) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.208516) * cos_heading + (size_float * -0.303240) * sin_heading;
                y: center - (size_float * 0.208516) * sin_heading + (size_float * -0.303240) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.226871) * cos_heading + (size_float * -0.329453) * sin_heading;
                y: center - (size_float * 0.226871) * sin_heading + (size_float * -0.329453) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.231990) * cos_heading + (size_float * -0.325868) * sin_heading;
                y: center - (size_float * 0.231990) * sin_heading + (size_float * -0.325868) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.213636) * cos_heading + (size_float * -0.299656) * sin_heading;
                y: center - (size_float * 0.213636) * sin_heading + (size_float * -0.299656) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.213760) * cos_heading + (size_float * -0.264473) * sin_heading;
                y: center - (size_float * 0.213760) * sin_heading + (size_float * -0.264473) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.252327) * cos_heading + (size_float * -0.310435) * sin_heading;
                y: center - (size_float * 0.252327) * sin_heading + (size_float * -0.310435) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.261903) * cos_heading + (size_float * -0.302400) * sin_heading;
                y: center - (size_float * 0.261903) * sin_heading + (size_float * -0.302400) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.223336) * cos_heading + (size_float * -0.256438) * sin_heading;
                y: center - (size_float * 0.223336) * sin_heading + (size_float * -0.256438) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.258006) * cos_heading + (size_float * -0.262425) * sin_heading;
                y: center - (size_float * 0.258006) * sin_heading + (size_float * -0.262425) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.280633) * cos_heading + (size_float * -0.285052) * sin_heading;
                y: center - (size_float * 0.280633) * sin_heading + (size_float * -0.285052) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.285052) * cos_heading + (size_float * -0.280633) * sin_heading;
                y: center - (size_float * 0.285052) * sin_heading + (size_float * -0.280633) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.262425) * cos_heading + (size_float * -0.258006) * sin_heading;
                y: center - (size_float * 0.262425) * sin_heading + (size_float * -0.258006) * cos_heading;
            }

            Close { }
        }

        // card ticks 50deg to 95deg, they turn with the card
        Path {
            viewbox-x: size_float * 0.100000 - 2.5000;
            viewbox-y: size_float * 0.100000 - 2.5000;
            viewbox-width: size_float * 0.800000 + 5.0000;
            viewbox-height: size_float * 0.800000 + 5.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: center + (size_float * 0.256438) * cos_heading + (size_float * -0.223336) * sin_heading;
                y: center - (size_float * 0.256438) * sin_heading + (size_float * -0.223336) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.302400) * cos_heading + (size_float * -0.261903) * sin_heading;
                y: center - (size_float * 0.302400) * sin_heading + (size_float * -0.261903) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.310435) * cos_heading + (size_float * -0.252327) * sin_heading;
                y: center - (size_float * 0.310435) * sin_heading + (size_float * -0.252327) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.264473) * cos_heading + (size_float * -0.213760) * sin_heading;
                y: center - (size_float * 0.264473) * sin_heading + (size_float * -0.213760) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.299656) * cos_heading + (size_float * -0.213636) * sin_heading;
                y: center - (size_float * 0.299656) * sin_heading + (size_float * -0.213636) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.325868) * cos_heading + (size_float * -0.231990) * sin_heading;
                y: center - (size_float * 0.325868) * sin_heading + (size_float * -0.231990) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.329453) * cos_heading + (size_float * -0.226871) * sin_heading;
                y: center - (size_float * 0.329453) * sin_heading + (size_float * -0.226871) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.303240) * cos_heading + (size_float * -0.208516) * sin_heading;
                y: center - (size_float * 0.303240) * sin_heading + (size_float * -0.208516) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.291324) * cos_heading + (size_float * -0.175413) * sin_heading;
                y: center - (size_float * 0.291324) * sin_heading + (size_float * -0.175413) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.343285) * cos_heading + (size_float * -0.205413) * sin_heading;
                y: center - (size_float * 0.343285) * sin_heading + (size_float * -0.205413) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.349535) * cos_heading + (size_float * -0.194587) * sin_heading;
                y: center - (size_float * 0.349535) * sin_heading + (size_float * -0.194587) * cos_heading;
            }

            LineTo {
