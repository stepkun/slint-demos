// An attitude indicator

import { Theme } from "theme.slint";

export component Attitude inherits Rectangle {
    // bank angle, positive is a right bank
    in property <angle> roll: 0deg;
    // pitch angle, positive is nose up
    in property <angle> pitch: 0deg;

    property <length> size: min(self.width, self.height);
    property <length> outer_thickness: size * Theme.ring_ratio;
    property <float> size_float: size / 1px;

    // inner part, all values in viewbox units
    // the geometry is calculated instead of using transform-rotation,
    // because the software renderer (used on MCUs) does not support rotations
    property <float> center: size_float / 2;
    property <float> inner_radius: center - outer_thickness / 1px;
    // distance per degree of pitch, 25 degree reach the inner edge
    property <float> pitch_scale: inner_radius / 25;
    // direction along the horizon (u) and perpendicular downwards (n)
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the roll.
    property <float> ux: cos_of(root.roll);
    property <float> uy: -sin_of(root.roll);
    property <float> nx: sin_of(root.roll);
    property <float> ny: cos_of(root.roll);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }
    // distance of the horizon from the center, positive is below the center
    property <float> pitch_offset: root.pitch / 1deg * pitch_scale;
    // kept slightly inside the circle, so there is always some sky and ground
    property <float> horizon_offset: max(-0.98 * inner_radius, min(0.98 * inner_radius, pitch_offset));
    property <float> half_chord: sqrt(inner_radius * inner_radius - horizon_offset * horizon_offset);
    // horizon end points on the inner circle
    property <float> left_x: center + horizon_offset * nx - half_chord * ux;
    property <float> left_y: center + horizon_offset * ny - half_chord * uy;
    property <float> right_x: center + horizon_offset * nx + half_chord * ux;
    property <float> right_y: center + horizon_offset * ny + half_chord * uy;

    // On MCUs every Path needs a temporary buffer of one byte per pixel of its box,
    // so the paths are combined where possible and their boxes are kept small.

    // The paths are built from MoveTo/LineTo elements with calculated coordinates instead of
    // command strings: formatting and parsing the numbers of a string is slow on the RP2040.
    // (Path elements can't be created with `for` yet, so they are written out.)

    // Pitch ladder: lines every 5 degree from -30 to 30, extra long (0.30 of the inner radius)
    // every 20 degree, long (0.20) every 10 degree, short (0.10) in between. A line is drawn
    // only while it is completely inside 0.95 of the inner radius:
    // offset² + (length · r)² < 0.9 r² with offset = r / 25 · (pitch - step) is the same as
    // |pitch - step| < 25 · sqrt(0.9 - length²), i.e. 23.585 (short), 23.184 (long) and
    // 22.5 degree (extra long); otherwise both ends are the same point and nothing is drawn.
    // The coordinates are written out instead of calling functions: in a function every call
    // reads the properties again, and each read costs a dependency node of heap.

    background: transparent;    // show background of parent

    // upper half outer ring: a circle border, clipped to the upper half
    Rectangle {
        x: 0px;
        y: 0px;
        width: size;
        height: size / 2;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: size;
            height: size;
            border-radius: size / 2;
            // 2px wider than the ring, under the inner sky disc (which is 1px smaller than the
            // inner circle): with anti-aliased edges at the same radius the background would show
            // through as a thin circle
            border-width: outer_thickness + 2px;
            border-color: Theme.sky;
        }
    }

    // lower half outer ring: a circle border, clipped to the lower half
    Rectangle {
        x: 0px;
        y: size / 2;
        width: size;
        height: size / 2;
        clip: true;

        Rectangle {
            x: 0px;
            y: -size / 2;
            width: size;
            height: size;
            border-radius: size / 2;
            // 2px under the inner disc, see above
            border-width: outer_thickness + 2px;
            border-color: Theme.ground;
        }
    }

    // Bank ticks, in four paths with tight boxes: the ticks are static, and a box overlapping
    // the moving inner disc would make them be redrawn every frame. Separate Tick components
    // would be simpler, but each instance costs several KB of heap.
    // The ticks are thin filled quadrilaterals (the same as a stroke with butt caps), the
    // viewboxes are tight (1 unit margin), without a stroke the box is the viewbox.
    // The coordinates are `size_float * A + B` with precomputed A and B, so each binding depends
    // on one property only: the dependencies of bindings that use `center`, `inner_radius` and
    // functions cost a lot more heap. Run tools/dial-paths.py again after changing the ticks,
    // Theme.ring_ratio or Theme.marking_width.

    // BEGIN generated by tools/dial-paths.py, do not edit
    // 0deg
    Path {
        viewbox-x: size_float * 0.500000 - 2.5000;
        viewbox-y: -1.0000;
        viewbox-width: 5.0000;
        viewbox-height: size_float * 0.100000 + 2.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.500000 - 1.5000;
            y: size_float * 0.100000;
        }

        LineTo {
            x: size_float * 0.500000 - 1.5000;
            y: -0.0000;
        }

        LineTo {
            x: size_float * 0.500000 + 1.5000;
            y: 0.0000;
        }

        LineTo {
            x: size_float * 0.500000 + 1.5000;
            y: size_float * 0.100000;
        }

        Close { }
    }

    // -20deg, -10deg, 10deg, 20deg
    Path {
        viewbox-x: size_float * 0.328990 - 1.7048;
        viewbox-y: size_float * 0.007596 - 1.1302;
        viewbox-width: size_float * 0.342020 + 3.4095;
        viewbox-height: size_float * 0.116527 + 2.3868;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.363192 - 0.7048;
            y: size_float * 0.124123 + 0.2565;
        }

        LineTo {
            x: size_float * 0.328990 - 0.7048;
            y: size_float * 0.030154 + 0.2565;
        }

        LineTo {
            x: size_float * 0.328990 + 0.7048;
            y: size_float * 0.030154 - 0.2565;
        }

        LineTo {
            x: size_float * 0.363192 + 0.7048;
            y: size_float * 0.124123 - 0.2565;
        }

        Close { }

        MoveTo {
            x: size_float * 0.430541 - 0.7386;
            y: size_float * 0.106077 + 0.1302;
        }

        LineTo {
            x: size_float * 0.413176 - 0.7386;
            y: size_float * 0.007596 + 0.1302;
        }

        LineTo {
            x: size_float * 0.413176 + 0.7386;
            y: size_float * 0.007596 - 0.1302;
        }

        LineTo {
            x: size_float * 0.430541 + 0.7386;
            y: size_float * 0.106077 - 0.1302;
        }

        Close { }

        MoveTo {
            x: size_float * 0.569459 - 0.7386;
            y: size_float * 0.106077 - 0.1302;
        }

        LineTo {
            x: size_float * 0.586824 - 0.7386;
            y: size_float * 0.007596 - 0.1302;
        }

        LineTo {
            x: size_float * 0.586824 + 0.7386;
            y: size_float * 0.007596 + 0.1302;
        }

        LineTo {
            x: size_float * 0.569459 + 0.7386;
            y: size_float * 0.106077 + 0.1302;
        }

        Close { }

        MoveTo {
            x: size_float * 0.636808 - 0.7048;
            y: size_float * 0.124123 - 0.2565;
        }

        LineTo {
            x: size_float * 0.671010 - 0.7048;
            y: size_float * 0.030154 - 0.2565;
        }

        LineTo {
            x: size_float * 0.671010 + 0.7048;
            y: size_float * 0.030154 + 0.2565;
        }

        LineTo {
            x: size_float * 0.636808 + 0.7048;
            y: size_float * 0.124123 + 0.2565;
        }

        Close { }
    }

    // -60deg, -30deg
    Path {
        viewbox-x: size_float * 0.066987 - 1.7500;
        viewbox-y: size_float * 0.066987 - 1.7500;
        viewbox-width: size_float * 0.233013 + 4.0490;
        viewbox-height: size_float * 0.233013 + 4.0490;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.153590 - 0.7500;
            y: size_float * 0.300000 + 1.2990;
        }

        LineTo {
            x: size_float * 0.066987 - 0.7500;
            y: size_float * 0.250000 + 1.2990;
        }

        LineTo {
            x: size_float * 0.066987 + 0.7500;
            y: size_float * 0.250000 - 1.2990;
        }

        LineTo {
            x: size_float * 0.153590 + 0.7500;
            y: size_float * 0.300000 - 1.2990;
        }

        Close { }

        MoveTo {
            x: size_float * 0.300000 - 1.2990;
            y: size_float * 0.153590 + 0.7500;
        }

        LineTo {
            x: size_float * 0.250000 - 1.2990;
            y: size_float * 0.066987 + 0.7500;
        }

        LineTo {
            x: size_float * 0.250000 + 1.2990;
            y: size_float * 0.066987 - 0.7500;
        }

        LineTo {
            x: size_float * 0.300000 + 1.2990;
            y: size_float * 0.153590 - 0.7500;
        }

        Close { }
    }

    // 30deg, 60deg
    Path {
        viewbox-x: size_float * 0.700000 - 2.2990;
        viewbox-y: size_float * 0.066987 - 1.7500;
        viewbox-width: size_float * 0.233013 + 4.0490;
        viewbox-height: size_float * 0.233013 + 4.0490;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.700000 - 1.2990;
            y: size_float * 0.153590 - 0.7500;
        }

        LineTo {
            x: size_float * 0.750000 - 1.2990;
            y: size_float * 0.066987 - 0.7500;
        }

        LineTo {
            x: size_float * 0.750000 + 1.2990;
            y: size_float * 0.066987 + 0.7500;
        }

        LineTo {
            x: size_float * 0.700000 + 1.2990;
            y: size_float * 0.153590 + 0.7500;
        }

        Close { }

        MoveTo {
            x: size_float * 0.846410 - 0.7500;
            y: size_float * 0.300000 - 1.2990;
        }

        LineTo {
            x: size_float * 0.933013 - 0.7500;
            y: size_float * 0.250000 - 1.2990;
        }

        LineTo {
            x: size_float * 0.933013 + 0.7500;
            y: size_float * 0.250000 + 1.2990;
        }

        LineTo {
            x: size_float * 0.846410 + 0.7500;
            y: size_float * 0.300000 + 1.2990;
        }

        Close { }
    }

    // END generated by tools/dial-paths.py

    // left horizontal line
    Rectangle {
        x: 0px;
        y: (size - Theme.marking_width) / 2;
        width: outer_thickness;
        height: Theme.marking_width;
        background: Theme.marking;
    }

    // right horizontal line
    Rectangle {
        x: size - outer_thickness;
        y: (size - Theme.marking_width) / 2;
        width: outer_thickness;
        height: Theme.marking_width;
        background: Theme.marking;
    }

    // inner part: sky as full disc
    // 1px smaller than the inner circle, its edge lies on the ring: at the same radius as the
    // ground path its anti-aliased edge would show through the edge of the ground as a thin line
    Rectangle {
        x: outer_thickness + 1px;
        y: outer_thickness + 1px;
        width: size - 2 * outer_thickness - 2px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.sky;
    }

    // inner part: ground below the horizon
    // from the right end of the horizon clockwise around the bottom to the left end
    // the arc is the larger one, when the horizon is above the center
    Path {
        x: outer_thickness;
        y: outer_thickness;
        width: size - 2 * outer_thickness;
        height: self.width;
        // box of the inner disc, coordinates stay the same as for the full size
        viewbox-x: outer_thickness / 1px;
        viewbox-y: outer_thickness / 1px;
        viewbox-width: 2 * inner_radius;
        viewbox-height: 2 * inner_radius;
        fill: Theme.ground;

        MoveTo {
            x: left_x;
            y: left_y;
        }

        LineTo {
            x: right_x;
            y: right_y;
        }

        ArcTo {
            x: left_x;
            y: left_y;
            radius-x: inner_radius;
            radius-y: inner_radius;
            large-arc: horizon_offset < 0;
            sweep: true;
        }

        Close { }
    }

    // inner part: horizon line
    Path {
        x: outer_thickness;
        y: outer_thickness;
        width: size - 2 * outer_thickness;
        height: self.width;
        // box of the inner disc, coordinates stay the same as for the full size
        viewbox-x: outer_thickness / 1px;
        viewbox-y: outer_thickness / 1px;
        viewbox-width: 2 * inner_radius;
        viewbox-height: 2 * inner_radius;
        stroke: Theme.marking;
        stroke-width: Theme.marking_width;

        MoveTo {
            x: left_x;
            y: left_y;
        }

        LineTo {
            x: right_x;
            y: right_y;
        }
    }

    // inner part: pitch ladder
    Path {
        x: outer_thickness;
        y: outer_thickness;
        width: size - 2 * outer_thickness;
        height: self.width;
        // box of the inner disc, coordinates stay the same as for the full size
        viewbox-x: outer_thickness / 1px;
        viewbox-y: outer_thickness / 1px;
        viewbox-width: 2 * inner_radius;
        viewbox-height: 2 * inner_radius;
        stroke: Theme.marking;
        stroke-width: Theme.marking_width / 2;

        MoveTo {
            x: center + (pitch_offset + 30 * pitch_scale) * nx + (abs(root.pitch / 1deg + 30) < 23.184 ? -0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 30 * pitch_scale) * ny + (abs(root.pitch / 1deg + 30) < 23.184 ? -0.20 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset + 30 * pitch_scale) * nx + (abs(root.pitch / 1deg + 30) < 23.184 ? 0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 30 * pitch_scale) * ny + (abs(root.pitch / 1deg + 30) < 23.184 ? 0.20 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset + 25 * pitch_scale) * nx + (abs(root.pitch / 1deg + 25) < 23.585 ? -0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 25 * pitch_scale) * ny + (abs(root.pitch / 1deg + 25) < 23.585 ? -0.10 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset + 25 * pitch_scale) * nx + (abs(root.pitch / 1deg + 25) < 23.585 ? 0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 25 * pitch_scale) * ny + (abs(root.pitch / 1deg + 25) < 23.585 ? 0.10 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset + 20 * pitch_scale) * nx + (abs(root.pitch / 1deg + 20) < 22.5 ? -0.30 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 20 * pitch_scale) * ny + (abs(root.pitch / 1deg + 20) < 22.5 ? -0.30 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset + 20 * pitch_scale) * nx + (abs(root.pitch / 1deg + 20) < 22.5 ? 0.30 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 20 * pitch_scale) * ny + (abs(root.pitch / 1deg + 20) < 22.5 ? 0.30 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset + 15 * pitch_scale) * nx + (abs(root.pitch / 1deg + 15) < 23.585 ? -0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 15 * pitch_scale) * ny + (abs(root.pitch / 1deg + 15) < 23.585 ? -0.10 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset + 15 * pitch_scale) * nx + (abs(root.pitch / 1deg + 15) < 23.585 ? 0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 15 * pitch_scale) * ny + (abs(root.pitch / 1deg + 15) < 23.585 ? 0.10 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset + 10 * pitch_scale) * nx + (abs(root.pitch / 1deg + 10) < 23.184 ? -0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 10 * pitch_scale) * ny + (abs(root.pitch / 1deg + 10) < 23.184 ? -0.20 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset + 10 * pitch_scale) * nx + (abs(root.pitch / 1deg + 10) < 23.184 ? 0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 10 * pitch_scale) * ny + (abs(root.pitch / 1deg + 10) < 23.184 ? 0.20 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset + 5 * pitch_scale) * nx + (abs(root.pitch / 1deg + 5) < 23.585 ? -0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 5 * pitch_scale) * ny + (abs(root.pitch / 1deg + 5) < 23.585 ? -0.10 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset + 5 * pitch_scale) * nx + (abs(root.pitch / 1deg + 5) < 23.585 ? 0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset + 5 * pitch_scale) * ny + (abs(root.pitch / 1deg + 5) < 23.585 ? 0.10 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset - 5 * pitch_scale) * nx + (abs(root.pitch / 1deg - 5) < 23.585 ? -0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 5 * pitch_scale) * ny + (abs(root.pitch / 1deg - 5) < 23.585 ? -0.10 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset - 5 * pitch_scale) * nx + (abs(root.pitch / 1deg - 5) < 23.585 ? 0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 5 * pitch_scale) * ny + (abs(root.pitch / 1deg - 5) < 23.585 ? 0.10 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset - 10 * pitch_scale) * nx + (abs(root.pitch / 1deg - 10) < 23.184 ? -0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 10 * pitch_scale) * ny + (abs(root.pitch / 1deg - 10) < 23.184 ? -0.20 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset - 10 * pitch_scale) * nx + (abs(root.pitch / 1deg - 10) < 23.184 ? 0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 10 * pitch_scale) * ny + (abs(root.pitch / 1deg - 10) < 23.184 ? 0.20 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset - 15 * pitch_scale) * nx + (abs(root.pitch / 1deg - 15) < 23.585 ? -0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 15 * pitch_scale) * ny + (abs(root.pitch / 1deg - 15) < 23.585 ? -0.10 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset - 15 * pitch_scale) * nx + (abs(root.pitch / 1deg - 15) < 23.585 ? 0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 15 * pitch_scale) * ny + (abs(root.pitch / 1deg - 15) < 23.585 ? 0.10 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset - 20 * pitch_scale) * nx + (abs(root.pitch / 1deg - 20) < 22.5 ? -0.30 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 20 * pitch_scale) * ny + (abs(root.pitch / 1deg - 20) < 22.5 ? -0.30 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset - 20 * pitch_scale) * nx + (abs(root.pitch / 1deg - 20) < 22.5 ? 0.30 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 20 * pitch_scale) * ny + (abs(root.pitch / 1deg - 20) < 22.5 ? 0.30 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset - 25 * pitch_scale) * nx + (abs(root.pitch / 1deg - 25) < 23.585 ? -0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 25 * pitch_scale) * ny + (abs(root.pitch / 1deg - 25) < 23.585 ? -0.10 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset - 25 * pitch_scale) * nx + (abs(root.pitch / 1deg - 25) < 23.585 ? 0.10 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 25 * pitch_scale) * ny + (abs(root.pitch / 1deg - 25) < 23.585 ? 0.10 * inner_radius : 0) * uy;
        }

        MoveTo {
            x: center + (pitch_offset - 30 * pitch_scale) * nx + (abs(root.pitch / 1deg - 30) < 23.184 ? -0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 30 * pitch_scale) * ny + (abs(root.pitch / 1deg - 30) < 23.184 ? -0.20 * inner_radius : 0) * uy;
        }

        LineTo {
            x: center + (pitch_offset - 30 * pitch_scale) * nx + (abs(root.pitch / 1deg - 30) < 23.184 ? 0.20 * inner_radius : 0) * ux;
            y: center + (pitch_offset - 30 * pitch_scale) * ny + (abs(root.pitch / 1deg - 30) < 23.184 ? 0.20 * inner_radius : 0) * uy;
        }
    }

    // bank pointer: triangle just inside the ring pointing at the bank scale
    // turns against the roll, so it points to the current bank angle
    Path {
        x: outer_thickness;
        y: outer_thickness;
        width: size - 2 * outer_thickness;
        height: self.width;
        // box of the inner disc, coordinates stay the same as for the full size
        viewbox-x: outer_thickness / 1px;
        viewbox-y: outer_thickness / 1px;
        viewbox-width: 2 * inner_radius;
        viewbox-height: 2 * inner_radius;
        fill: Theme.vehicle;

        // distances from the center: tip touches the inner edge of the ring
        property <float> tip: inner_radius;
        property <float> base: center - outer_thickness * 1.5 / 1px;
        property <float> half_base: outer_thickness / 3 / 1px;

        // "up" rotated by -roll is -n, the base runs along u
        MoveTo {
            x: center - tip * nx;
            y: center - tip * ny;
        }

        LineTo {
            x: center - base * nx + half_base * ux;
            y: center - base * ny + half_base * uy;
        }

        LineTo {
            x: center - base * nx - half_base * ux;
            y: center - base * ny - half_base * uy;
        }

        Close { }
    }

    // vehicle symbol: two horizontal lines with downward pointing inner ends
    // drawn last so it stays on top of everything else
    Path {
        x: size * 0.2;
        y: size * 0.48;
        width: size * 0.6;
        height: size * 0.1;
        // box around the wings, coordinates stay the same as for the full size
        viewbox-x: size_float * 0.2;
        viewbox-y: size_float * 0.48;
        viewbox-width: size_float * 0.6;
        viewbox-height: size_float * 0.1;
        stroke: Theme.vehicle;
        stroke-width: Theme.vehicle_width;
        stroke-line-cap: round;
        stroke-line-join: round;

        // left wing
        MoveTo {
            x: size_float * 0.22;
            y: size_float / 2;
        }

        LineTo {
            x: size_float * 0.40;
            y: size_float / 2;
        }

        LineTo {
            x: size_float * 0.40;
            y: size_float * 0.55;
        }
        // right wing
        MoveTo {
            x: size_float * 0.78;
            y: size_float / 2;
        }

        LineTo {
            x: size_float * 0.60;
            y: size_float / 2;
        }

        LineTo {
            x: size_float * 0.60;
            y: size_float * 0.55;
        }
    }

    // vehicle center dot
    Rectangle {
        x: (size - 2 * Theme.vehicle_width) / 2;
        y: (size - 2 * Theme.vehicle_width) / 2;
        width: 2 * Theme.vehicle_width;
        height: 2 * Theme.vehicle_width;
        border-radius: self.width / 2;
        background: Theme.vehicle;
    }
}
