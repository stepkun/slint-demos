// An airspeed indicator in knots

import { Theme } from "theme.slint";

export component Airspeed inherits Rectangle {
    // indicated airspeed in knots
    in property <float> airspeed: 0;

    private property <length> size: min(self.width, self.height);
    private property <float> size_float: size / 1px;
    // widths and font sizes are those of Theme at Theme.reference_size, scaled with the size of
    // the instrument, so it keeps its proportions on the desktop; exactly 1 on the device
    private property <float> scale: size / Theme.reference_size;
    // font size on whole pixels: the device has glyphs of the sizes in Theme only, and a
    // fraction below them would fall back to the next smaller size
    private property <length> font_size: round(Theme.font_size * scale / 1px) * 1px;
    private property <length> large_font_size: round(Theme.large_font_size * scale / 1px) * 1px;

    // all values in viewbox units, which are pixels of the instrument
    private property <float> center: size_float / 2;
    // No bezel ring: the dial is as large as the instrument, the coloured arcs (out to 1.10 of
    // the inner radius) end just inside its edge. 0.45 is 0.5 - RING_RATIO of the airspeed dial
    // in tools/dial-paths.py, keep both in sync.
    private property <float> inner_radius: size_float * 0.45;
    // The numbers are on the dial inside the long ticks (0.85 of the inner radius), like on a
    // real indicator. The needle passes over them, then only the small numbers are redrawn
    // (pre-rendered glyphs), no paths. The unit sits at the top edge, in the gap of the scale.
    private property <float> label_half_width: size_float * 0.06;
    private property <float> label_half_height: size_float * 0.03;
    private property <float> label_radius: center - label_half_height - 1;
    // the numbers in Theme.large_font_size: boxes large enough for three digits (the device
    // clips text to its box), far enough inside that they stay clear of the long ticks at 3 and
    // 9 o'clock
    private property <float> number_half_width: size_float * 0.075;
    private property <float> number_half_height: size_float * 0.045;
    private property <float> number_radius: inner_radius * 0.62;

    // Only the needle moves. Every static part has a box that no needle box can reach, so the
    // moving needle never makes the ticks, arcs or labels be redrawn: the needle is at most 0.74
    // of the inner radius long, and the ticks and arcs are grouped and cut so that no box comes
    // nearer to the center than 0.79 of it (checked for all angles by tools/dial-paths.py).

    // Scale: 0 to 40 kt on the first 30 degree, then 1.875 degree per kt, so 40 to 200 kt fill
    // 30 to 330 degree (the same in tools/dial-paths.py). Below 40 kt the needle rests near
    // the top like on a real indicator, above 210 kt it stops before the 0 kt position.
    private property <angle> needle_angle: root.airspeed < 40 ? max(root.airspeed, 0) * 0.75deg : 30deg + (min(root.airspeed, 210) - 40) * 1.875deg;

    // direction of the needle as sine and cosine of its angle, clockwise from 12 o'clock
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the airspeed.
    private property <float> sin_needle: sin_of(needle_angle);
    private property <float> cos_needle: cos_of(needle_angle);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // a point of the needle: `along` it from the center (negative is the tail) and `across` it
    // (positive is to the right of the needle when it points up)
    pure function needle_x(along: float, across: float) -> float {
        return center + along * sin_needle + across * cos_needle;
    }
    pure function needle_y(along: float, across: float) -> float {
        return center - along * cos_needle + across * sin_needle;
    }

    // a point on the dial at angle `a` (clockwise from 12 o'clock) and the given distance
    pure function dial_x(a: angle, distance: float) -> float {
        return center + distance * sin(a);
    }
    pure function dial_y(a: angle, distance: float) -> float {
        return center - distance * cos(a);
    }

    background: transparent;    // show background of parent

    // all parts in a square of `size`, centered in the area the instrument is given
    Rectangle {
        x: (root.width - root.size) / 2;
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;

        // Coloured arcs (white: flaps, green: normal, yellow: caution) outside the ticks, from 1.0
        // to 1.10 of the inner radius, cut into pieces with tight boxes, then ticks every 5 kt
        // from 40 to 200 kt, long and wide ones every 10 kt, ending at the inner radius (long ones
        // from 0.85, short ones from 0.92 of it), and the red line at the never exceed speed on top.
        // The ticks are thin filled quadrilaterals instead of strokes: a Path has only one stroke
        // width, filled ticks of both sizes can share a path, and fewer paths need less heap.
        // The viewboxes are tight (1 unit margin), without a stroke the box is the viewbox.
        // The coordinates are `size_float * A + B` with precomputed A and B, so each binding depends
        // on one property only: the dependencies of bindings that use `center`, `inner_radius` and
        // functions cost a lot more heap. The speeds of the arcs (a typical small trainer) are set in
        // tools/dial-paths.py. Run it again after changing them, the size of the dial,
        // Theme.marking_width or the needle.

        // BEGIN generated by tools/dial-paths.py, do not edit
        // white arc, 30deg to 51deg
        Path {
            viewbox-x: size_float * 0.725000 - 1.0000;
            viewbox-y: size_float * 0.094700 - 1.0000;
            viewbox-width: size_float * 0.138704 + 2.0000;
            viewbox-height: size_float * 0.122106 + 2.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: size_float * 0.734000;
                y: size_float * 0.094700;
            }

            ArcTo {
                x: size_float * 0.863704;
                y: size_float * 0.205478;
                radius-x: size_float * 0.468000;
                radius-y: size_float * 0.468000;
                sweep: true;
            }

            LineTo {
                x: size_float * 0.849716;
                y: size_float * 0.216806;
            }

            ArcTo {
                x: size_float * 0.725000;
                y: size_float * 0.110289;
                radius-x: size_float * 0.450000;
                radius-y: size_float * 0.450000;
                sweep: false;
            }

            Close { }
        }

        // white arc, 51deg to 78.75deg
        Path {
            viewbox-x: size_float * 0.849716 - 1.0000;
            viewbox-y: size_float * 0.205478 - 1.0000;
