        // needle, its box follows it, so only the area around the needle is redrawn when it moves
        Path {
            // shape in units along and across the needle
            private property <float> tip: inner_radius * 0.74;
            private property <float> shoulder: inner_radius * 0.66;
            private property <float> tail: inner_radius * 0.12;
            private property <float> half_width: Theme.marking_width * scale * 0.8 / 1px;

            private property <float> tail_left_x: needle_x(-tail, -half_width);
            private property <float> tail_left_y: needle_y(-tail, -half_width);
            private property <float> shoulder_left_x: needle_x(shoulder, -half_width);
            private property <float> shoulder_left_y: needle_y(shoulder, -half_width);
            private property <float> tip_x: needle_x(tip, 0);
            private property <float> tip_y: needle_y(tip, 0);
            private property <float> shoulder_right_x: needle_x(shoulder, half_width);
            private property <float> shoulder_right_y: needle_y(shoulder, half_width);
            private property <float> tail_right_x: needle_x(-tail, half_width);
            private property <float> tail_right_y: needle_y(-tail, half_width);

            // viewbox tight around the needle (1 unit margin), no stroke, so the box is the viewbox
            viewbox-x: min(tail_left_x, shoulder_left_x, tip_x, shoulder_right_x, tail_right_x) - 1;
            viewbox-y: min(tail_left_y, shoulder_left_y, tip_y, shoulder_right_y, tail_right_y) - 1;
            viewbox-width: max(tail_left_x, shoulder_left_x, tip_x, shoulder_right_x, tail_right_x) - self.viewbox-x + 1;
            viewbox-height: max(tail_left_y, shoulder_left_y, tip_y, shoulder_right_y, tail_right_y) - self.viewbox-y + 1;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.needles;

            MoveTo {
                x: tail_left_x;
                y: tail_left_y;
            }

            LineTo {
                x: shoulder_left_x;
                y: shoulder_left_y;
            }

            LineTo {
                x: tip_x;
                y: tip_y;
            }

            LineTo {
                x: shoulder_right_x;
                y: shoulder_right_y;
            }

            LineTo {
                x: tail_right_x;
                y: tail_right_y;
            }

            Close { }
        }
    }
}
