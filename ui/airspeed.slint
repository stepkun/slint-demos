// An airspeed indicator in knots

import { Theme } from "theme.slint";

export component Airspeed inherits Rectangle {
    // indicated airspeed in knots
    in property <float> airspeed: 0;

    property <length> size: min(self.width, self.height);
    property <length> outer_thickness: size * Theme.ring_ratio;
    property <float> size_float: size / 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    property <float> inner_radius: center - outer_thickness / 1px;
    // the labels sit in the ring, outside the coloured arcs
    property <float> label_radius: center - outer_thickness * 0.3 / 1px;
    property <float> label_half_width: outer_thickness * 0.46 / 1px;
    property <float> label_half_height: outer_thickness * 0.3 / 1px;

    // Only the needle moves. Every static part has a box that no needle box can reach, so the
    // moving needle never makes the ticks, arcs or labels be redrawn: the needle is at most 0.74
    // of the inner radius long, and the ticks and arcs are grouped and cut so that no box comes
    // nearer to the center than 0.79 of it (checked for all angles by tools/dial-paths.py).

    // Scale: 0 to 40 kt on the first 30 degree, then 1.875 degree per kt, so 40 to 200 kt fill
    // 30 to 330 degree (the same in tools/dial-paths.py). Below 40 kt the needle rests near
    // the top like on a real indicator, above 210 kt it stops before the 0 kt position.
    property <angle> needle_angle: root.airspeed < 40 ? max(root.airspeed, 0) * 0.75deg : 30deg + (min(root.airspeed, 210) - 40) * 1.875deg;

    // direction of the needle as sine and cosine of its angle, clockwise from 12 o'clock
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the airspeed.
    property <float> sin_needle: sin_of(needle_angle);
    property <float> cos_needle: cos_of(needle_angle);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // a point of the needle: `along` it from the center (negative is the tail) and `across` it
    // (positive is to the right of the needle when it points up)
    pure function needle_x(along: float, across: float) -> float {
        return center + along * sin_needle + across * cos_needle;
    }
    pure function needle_y(along: float, across: float) -> float {
        return center - along * cos_needle + across * sin_needle;
    }

    // a point on the dial at angle `a` (clockwise from 12 o'clock) and the given distance
    pure function dial_x(a: angle, distance: float) -> float {
        return center + distance * sin(a);
    }
    pure function dial_y(a: angle, distance: float) -> float {
        return center - distance * cos(a);
    }

    background: transparent;    // show background of parent

    // outer ring, the arcs and labels are placed on it
    Rectangle {
        x: 0px;
        y: 0px;
        width: size;
        height: size;
        border-radius: size / 2;
        border-width: outer_thickness;
        border-color: Theme.bezel;
    }

    // Coloured arcs (white: flaps, green: normal, yellow: caution) at the inner edge of the ring,
    // cut into pieces with tight boxes, then ticks every 5 kt from 40 to 200 kt, long and wide
    // ones every 10 kt, ending at the ring (long ones at 0.85, short ones at 0.92 of the inner
    // radius), and the red line at the never exceed speed on top.
    // The ticks are thin filled quadrilaterals instead of strokes: a Path has only one stroke
    // width, filled ticks of both sizes can share a path, and fewer paths need less heap.
    // The viewboxes are tight (1 unit margin), without a stroke the box is the viewbox.
    // The coordinates are `size_float * A + B` with precomputed A and B, so each binding depends
    // on one property only: the dependencies of bindings that use `center`, `inner_radius` and
    // functions cost a lot more heap. The speeds of the arcs (a typical small trainer) are set in
    // tools/dial-paths.py. Run it again after changing them, Theme.ring_ratio,
    // Theme.marking_width or the needle.

    // BEGIN generated by tools/dial-paths.py, do not edit
    // white arc, 30deg to 50.75deg
    Path {
        viewbox-x: size_float * 0.700000 - 1.0000;
        viewbox-y: size_float * 0.139733 - 1.0000;
        viewbox-width: size_float * 0.122147 + 2.0000;
        viewbox-height: size_float * 0.107184 + 2.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

        MoveTo {
            x: size_float * 0.708000;
            y: size_float * 0.139733;
        }

        ArcTo {
            x: size_float * 0.822147;
            y: size_float * 0.236795;
            radius-x: size_float * 0.416000;
            radius-y: size_float * 0.416000;
            sweep: true;
        }

        LineTo {
            x: size_float * 0.809757;
            y: size_float * 0.246918;
        }

        ArcTo {
            x: size_float * 0.700000;
            y: size_float * 0.153590;
            radius-x: size_float * 0.400000;
            radius-y: size_float * 0.400000;
            sweep: false;
        }

        Close { }
    }

    // white arc, 50.75deg to 77.75deg
    Path {
        viewbox-x: size_float * 0.809757 - 1.0000;
        viewbox-y: size_float * 0.236795 - 1.0000;
        viewbox-width: size_float * 0.096771 + 2.0000;
        viewbox-height: size_float * 0.178334 + 2.0000;
        x: self.viewbox-x * 1px;
        y: self.viewbox-y * 1px;
        width: self.viewbox-width * 1px;
        height: self.viewbox-height * 1px;
        fill: Theme.marking;

