        // labels every 500 fpm in hundreds of feet per minute, in the ring outside the reach of the
        // needle (written out, `for` would create a component instance per label)
        Text {
            x: (dial_x(270deg, label_radius) - label_half_width) * 1px;
            y: (dial_y(270deg, label_radius) - label_half_height) * 1px;
            width: 2px * label_half_width;
            height: 2px * label_half_height;
