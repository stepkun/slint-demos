// A vertical speed indicator in feet per minute

import { Theme } from "theme.slint";

export component VerticalSpeed inherits Rectangle {
    // vertical speed in feet per minute, positive is climbing
    in property <float> vertical_speed: 0;

    property <length> size: min(self.width, self.height);
    property <float> size_float: size / 1px;
    // widths and font sizes are those of Theme at Theme.reference_size, scaled with the size of
    // the instrument, so it keeps its proportions on the desktop; exactly 1 on the device
    property <float> scale: size / Theme.reference_size;
    // font size on whole pixels: the device has glyphs of the sizes in Theme only, and a
    // fraction below them would fall back to the next smaller size
    property <length> font_size: round(Theme.font_size * scale / 1px) * 1px;

    // all values in viewbox units, which are pixels of the instrument
    property <float> center: size_float / 2;
    // No bezel ring: the ticks reach almost to the edge of the instrument. 0.49 is
    // 0.5 - RING_RATIO of the vertical speed dial in tools/dial-paths.py, keep both in sync.
    property <float> inner_radius: size_float * 0.49;
    // The numbers are on the dial inside the long ticks (0.85 of the inner radius), like on a
    // real indicator. The needle passes over them, then only the small numbers are redrawn
    // (pre-rendered glyphs), no paths. "UP" and "DN" stay at the edge, in the gap of the scale
    // at 3 o'clock.
    property <float> label_half_width: size_float * 0.046;
    property <float> label_half_height: size_float * 0.03;
    property <float> number_radius: inner_radius * 0.72;
    property <float> label_radius: center - label_half_width - 1;

    // Only the needle moves. Every static part has a box that no needle box can reach, so the
    // moving needle never makes the ticks or labels be redrawn: the needle is at most 0.74 of the
    // inner radius long, and the ticks are grouped so that no box comes nearer to the center
    // than 0.79 of it (checked for all angles by tools/dial-paths.py).

    // Scale: 0 at 9 o'clock, climbing clockwise over the top, descending counterclockwise below
    // it. 0 to 1000 fpm take 90 degree, 1000 to 2000 fpm are compressed on 75 degree, like on a
    // real indicator (the same in tools/dial-paths.py). The needle stops at 2100 fpm, before
    // the "UP"/"DN" labels at 3 o'clock.
    property <float> speed: max(-2100, min(2100, root.vertical_speed));
    property <angle> deflection: abs(speed) <= 1000 ? abs(speed) * 0.09deg : 90deg + (abs(speed) - 1000) * 0.075deg;
    property <angle> needle_angle: speed >= 0 ? 270deg + deflection : 270deg - deflection;

    // direction of the needle as sine and cosine of its angle, clockwise from 12 o'clock
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the speed.
    property <float> sin_needle: sin_of(needle_angle);
    property <float> cos_needle: cos_of(needle_angle);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // a point of the needle: `along` it from the center (negative is the tail) and `across` it
    // (positive is to the right of the needle when it points up)
    pure function needle_x(along: float, across: float) -> float {
        return center + along * sin_needle + across * cos_needle;
    }
    pure function needle_y(along: float, across: float) -> float {
        return center - along * cos_needle + across * sin_needle;
    }

    // a point on the dial at angle `a` (clockwise from 12 o'clock) and the given distance
    pure function dial_x(a: angle, distance: float) -> float {
        return center + distance * sin(a);
    }
    pure function dial_y(a: angle, distance: float) -> float {
        return center - distance * cos(a);
    }

    background: transparent;    // show background of parent

    // all parts in a square of `size`, centered in the area the instrument is given
    Rectangle {
        x: (root.width - root.size) / 2;
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;

        // Ticks every 100 fpm from -2000 to 2000 fpm, long and wide ones every 500 fpm, ending at
        // the inner radius (long ones at 0.85, short ones at 0.92 of the inner radius).
        // The ticks are thin filled quadrilaterals instead of strokes: a Path has only one stroke
        // width, filled ticks of both sizes can share a path, and fewer paths need less heap.
        // The viewboxes are tight (1 unit margin), without a stroke the box is the viewbox.
        // The coordinates are `size_float * A + B` with precomputed A and B, so each binding depends
        // on one property only. Run tools/dial-paths.py again after changing the scale,
        // the size of the dial, Theme.marking_width or the needle.

        // BEGIN generated by tools/dial-paths.py, do not edit
        // 105deg, 112.5deg, 120deg
        Path {
            viewbox-x: size_float * 0.888842 - 1.0000;
            viewbox-y: size_float * 0.601761 - 1.0000;
            viewbox-width: size_float * 0.086080 + 2.0000;
            viewbox-height: size_float * 0.145945 + 2.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: size_float * 0.903926;
                y: size_float * 0.601761;
            }

            LineTo {
