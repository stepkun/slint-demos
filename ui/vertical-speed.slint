        // labels every 500 fpm in hundreds of feet per minute, on the dial inside the ticks
        // (written out, `for` would create a component instance per label)
        Text {
            x: (dial_x(270deg, number_radius) - label_half_width) * 1px;
            y: (dial_y(270deg, number_radius) - label_half_height) * 1px;
            width: 2px * label_half_width;
            height: 2px * label_half_height;
            text: "0";
            color: Theme.marking;
            font-size: font_size;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: TextVerticalAlignment.center;
