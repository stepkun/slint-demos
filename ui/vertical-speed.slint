        // direction of the scale, in the gap at 3 o'clock that the needle never reaches
        Text {
            x: (dial_x(84deg, label_radius) - label_half_width) * 1px;
            y: (dial_y(84deg, label_radius) - label_half_height) * 1px;
            width: 2px * label_half_width;
